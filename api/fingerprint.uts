export interface GuestAuthResponse {
  accessToken: string;
  expiresAt: string;
  user: UserItem;
}

export interface GuestAutoAuthParams {
  deviceFingerprint: string;
  tg_username?: string;
  tg_token?: string;
  promotional_code?: string;
}

export function guestAutoAuth(data: GuestAutoAuthParams): Promise<ApiResponse<GuestAuthResponse>> {
  const { deviceFingerprint, ...restData } = data;
  return request({
    url: `guest/auto-auth`,
    method: "POST",
    data: data,
    header: {
      "X-Device-Fingerprint": deviceFingerprint
    }
  });
