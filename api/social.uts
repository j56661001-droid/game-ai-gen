// 观看资源API
export const viewResource = canIgnore(async (resourceId: string): Promise<ApiResponse<any>> => {
  return await request<ApiResponse<any>>({
    url: `posts/${resourceId}/viewed`,
    method: "POST",
    customErrorHanlder: (_: any) => {},
  });
});

type NotificationInfo = {
	unreadCount: number;
}

// 获取未读通知数量
export const getUnreadCount = canIgnore(async (): Promise<ApiResponse<NotificationInfo> | null> => {
  return await request<ApiResponse<NotificationInfo>>({
    url: `notifications/unread-count`,
    method: "GET",
    customErrorHanlder: (_: any) => {}, // Suppress errors silently
  });
});
