}

export async function getForyou(page: number = 1, size: number = 10, otherParams?: AnyObject): Promise<ResourceListResponse | null> {
  return await request<ResourceListResponse>({
    // url: `homepage/for-you`,
    url: `recommend`,
    method: "GET",
    data: {
      page,
      size,
      ...otherParams,
    },
  });
}


export async function getForyouOld(page: number = 1, size: number = 10, otherParams?: AnyObject): Promise<ResourceListResponse | null> {
  return await request<ResourceListResponse>({
    url: `homepage/for-you`,
    method: "GET",
    data: {
      page,
      size,
      ...otherParams,
    },
  });
}


export async function getPosts(page: number = 1, size: number = 10, otherParams?: AnyObject): Promise<ResourceListResponse | null> {
  return await request<ResourceListResponse>({
    url: `posts`,
    method: "GET",
    data: {
      page,
