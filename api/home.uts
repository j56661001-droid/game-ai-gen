import { request } from "./request";
import type {
  ApiResponse,
  BannerItem,
  CategoryListResponse,
  CategoryListWithChildrenResponse,
  ResourceListResponse,
  PointsData,
  ClaimRewardsData,
} from "../types/index.uts";

// http://localhost:8080/api/homepage/popular-topics?page=1&size=20
export async function getPopularTopics(page: number = 1, size: number = 10, country: string | null = null): Promise<CategoryListResponse | null> {
  const data = {
    page,
    size,
  };
  if (country != null) {
    data.country = country;
  }
  return await request<CategoryListResponse>({
    url: `homepage/popular-topics`,
    method: "GET",
    data,
  });
}

export async function getPopularTopicsPosts(page: number = 1, size: number = 10): Promise<CategoryListWithChildrenResponse | null> {
  return await request<CategoryListWithChildrenResponse>({
    url: `homepage/popular-topics/posts?page=${page}&size=${size}`,
    method: "GET",
  });
}

// homepage/trending-zone
export async function getTrendingZone(page: number = 1, size: number = 10, country = undefined): Promise<CategoryListResponse | null> {
  const data = {
    page,
    size,
  };
  if (country) {
    data.country = country;
  }
  return await request<CategoryListResponse>({
    url: `homepage/trending-zone`,
    method: "GET",
    data,
  });
}

export async function getTrendingZonePosts(id: string, page: number = 1, size: number = 10): Promise<ResourceListResponse | null> {
  return await request<ResourceListResponse>({
    url: `homepage/trending-zone/${id}/posts?page=${page}&size=${size}`,
    method: "GET",
  });
}

export async function getStars(page: number = 1, size: number = 20): Promise<CategoryListWithChildrenResponse | null> {
  return await request<CategoryListWithChildrenResponse>({
    url: `homepage/stars?page=${page}&size=${size}`,
