import { isDevelopmentEnv, isCapacitor, getDomainFromUrl } from "@/utils/platform.uts";

export const config = {
  baseUrl: import.meta.env.VITE_API_BASE_URL,
};

tokenStorage.set('baseUrl', config.baseUrl);

