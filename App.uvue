}
/* #endif */

/* #ifdef WEB */
#app {
  position: relative;
  /* max-width: 750px; */
  margin: 0 auto;
  width: 100%;
  height: 100%;
  padding-bottom: env(safe-area-inset-bottom); /* 添加这一行 */
}
/* 全局滚动条样式 */
::-webkit-scrollbar {
  width: 3px;
  height: 3px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: #888; /* 可以根据需要调整滚动条颜色 */
  border-radius: 1.5px; /* 宽度的一半 */
}
/* #endif */

/** 登录 dialog */
uni-page[data-type="dialog"][data-page^="pages/account/login"] {
  z-index: 9999 !important;
}
uni-page[data-type="dialog"][data-page^="pages/account/register"] {
  z-index: 9999 !important;
}
</style>

<style>
/* ... existing styles */
.debug-app-source {
  position: fixed;
  top: 10px;
  left: 10px;
  background: rgba(0, 0, 0, 0.8);
  color: yellow;
  font-family: monospace;
  font-size: 14px;
  z-index: 10001;
  padding: 5px;
  border-radius: 3px;
}

.tg-login-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.8);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100000; /* Ensure it's on top of everything */
}

.tg-login-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background-color: rgba(0, 0, 0, 0.7);
  border-radius: 10px;
}

.tg-login-text {
  color: #ffffff;
