{
  "plugins": ["./prettier-plugin-uts.js"],
  "overrides": [
    {
      "files": "*.uvue",
      "options": {
        "parser": "vue"
      }
    },
    {
      "files": "*.uts",
      "options": {
        "parser": "typescript"
      }
    },
    {
      "files": "*.json",
      "options": {
        "parser": "json",
        "tabWidth": 2
      }
    }
  ],
  "printWidth": 160
}
