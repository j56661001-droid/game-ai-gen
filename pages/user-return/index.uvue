  </bp-navigation-bar-title>
</template>

<script setup lang="ts">
import { computed, ref } from "vue";
import { $i18n_t } from "@/locale/index.uts";
import { goBack } from "@/utils/page";
import { user, creditsBalance } from "@/store/user";
import { execGTagEvent, getUrlParameter } from "@/utils/index.uts";
import CreditsBalanceIcon from "../publish/panel/credits-balance-icon.uvue";
import { getReturnUserRewards, claimRewards } from "../../api/home.uts";
import { UserItem, ApiResponse, ClaimRewardsData } from "@/types/index.uts"; // 导入 ApiResponse
import { getDomainFromUrl, isTelegramMiniApp } from "@/utils/platform.uts"; // Import isTelegramMiniApp
import { appStore } from "@/store/index.uts"; // Import appStore
import { config } from "@/api/request.uts";
import type { ReferralCenterData, InvitationHistoryItem } from "@/types/affiliate.uts";
import { getAffiliateSummary, getAffiliateHistory } from "@/api/affiliate.uts";
import { FrSpin } from "@/components/widgets";
import PCSideBar from "@/components/PCSideBar/index.uvue";
import BpNavigationBarTitle from "@/components/panels/bp-navigation-bar-title.uvue";

const from = getUrlParameter("from", location.search); // Add this line to get the 'from' parameter
const userProfile = ref<UserItem>({
  id: "",
  username: "",
  avatar: "",
  email: "",
  bio: "",
  followersCount: 0,
  followingCount: 0,
  videoLikeCount: 0,
  photoLikeCount: 0,
  nickname: "",
  isFollowing: false,
  postsCount: 0,
  location: "",
  createdAt: "",
});
const activeTab = ref<"tasks" | "rewards">("tasks");
const list = ref([]);
const requiredCount = ref<num>(0);
const shareLink = ref<String>();
const createdTime = ref<String>();
const isTgMiniApp = ref<boolean>(false);
const inviteCode = ref<String>();
const history = ref<InvitationHistoryItem[]>([]);
const page = ref(1);
const pageSize = 5;
const loading = ref(false);
const hasMore = ref(true);

const baseRewardData = computed<num>(() => {
  return list.value.filter((item) => item.rewardLevel === 0)[0];
});

const isCurrentUser = computed<boolean>(() => {
  return userProfile.value.id == user.value?.id;
});

// 数组交换最后两项的方法
const swapLastTwoItems = (arr) => {
  const clonedArray = [...arr];
  if (clonedArray.length >= 2) {
    const len = clonedArray.length;
    [clonedArray[len - 1], clonedArray[len - 2]] = [clonedArray[len - 2], clonedArray[len - 1]];
  }
  return clonedArray;
};

// 计算剩余时间
const calculateTimeRemaining = (timeString) => {
  const initialTime = new Date(timeString);
  // 计算初始时间 + 6天后的时间
  const targetTime = new Date(initialTime.getTime() + 6 * 24 * 60 * 60 * 1000);
  // 获取当前时间
  const currentTime = new Date();
  // 计算时间差（毫秒）
  const timeDiff = targetTime.getTime() - currentTime.getTime();
  // 如果目标时间已经过去，返回负数表示已过期
  if (timeDiff <= 0) {
    return {
      days: 0,
      hours: 0,
      minutes: 0,
      isExpired: true,
    };
  }
  // 计算天、小时、分钟
  const days = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
  const hours = Math.floor((timeDiff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
  const minutes = Math.floor((timeDiff % (1000 * 60 * 60)) / (1000 * 60));
  return {
    days,
    hours,
    minutes,
    isExpired: false,
  };
};

const switchTab = (tab: "tasks" | "rewards") => {
  activeTab.value = tab;
};

const copyToClipboard = (value: string) => {
  uni.setClipboardData({
    data: value,
    success: () => {
      uni.showToast({
        title: $i18n_t("user_return.code_cussess"),
        icon: "none",
      });
    },
  });
};

const handleTaskClick = async (item) => {
  try {
    item.loading = true;
    const res = await claimRewards(userProfile.value.id, item.rewardLevel);
    item.loading = false;
    //领取成功
    uni.showToast({
      title: $i18n_t("task_center.obtained_reward"),
      icon: "success",
      duration: 3500,
    });
    initializeData();
    execGTagEvent("returning_reward", { pts: creditsBalance.value.toString(), serial: String(item.rewardLevel) } as AnyObject);
  } catch (error) {
    item.loading = false;
    console.error("Failed to load banner list:", error);
  }
};

const loadMoreHistory = async () => {
  if (loading.value || !hasMore.value || activeTab.value !== "rewards") {
    return;
  }
  loading.value = true;
  page.value++;
  try {
    const res = await getReturnUserRewards(userProfile.value.id, page.value, pageSize);
    const newHistory = res.data?.usersOutput || [];
    history.value.push(...newHistory);
    if (newHistory.length < pageSize) {
      hasMore.value = false;
    }
  } catch (error) {
    console.error("Failed to fetch more history:", error);
    page.value--; // revert page increase on error
  } finally {
    loading.value = false;
  }
};

const initializeData = async () => {
  try {
    await getAffiliateSummary(); // 应后端要求刷新接口，不做其他处理
    const res = await getReturnUserRewards(userProfile.value?.id, page.value, pageSize);
    if (res != null && res.success && res.data != null) {
      page.value = 1;
      hasMore.value = true;
      loading.value = true;
      const data = res.data;
      const historyData = data?.usersOutput || [];
      list.value = data?.claimRecords || [];
      requiredCount.value = data?.requiredCount || 0;
      createdTime.value = data?.createdAt;
      history.value = historyData;
      if (historyData.length < pageSize) {
        hasMore.value = false;
      }
      // 邀请码&邀请链接
      inviteCode.value = data?.inviteCode;
      if (isTgMiniApp.value && appStore.value.botUsername && appStore.value.appName) {
        shareLink.value = `https://t.me/${appStore.value.botUsername}/${appStore.value.appName}?startapp=${data?.inviteCode}`;
      } else {
        shareLink.value = `${effectiveDomain.value}/pages/index/index?promotional_code=${data?.inviteCode}`;
      }
    } else {
      console.error("Failed to load banner list:", pointsRes?.error?.message);
    }
  } catch (error) {
    console.error("Failed to fetch affiliate data:", error);
  } finally {
    loading.value = false;
  }
};

const effectiveDomain = computed(() => {
  if (typeof window !== "undefined" && window.location && window.location.protocol) {
    const protocol = window.location.protocol;
    if (protocol === "http:" || protocol === "https:") {
      return `${protocol}//${window.location.hostname}`;
    }
  }
  return getDomainFromUrl(config.baseUrl); // Fallback for non-browser environments or if window is undefined
});

onLoad(async (options: OnLoadOptions) => {
  const userId = options["userId"];
  if (userId != null && userId.length > 0) {
    userProfile.value.id = userId;
  } else {
    userProfile.value.id = user.value?.id || "";
  }
});

onMounted(() => {
  isTgMiniApp.value = isTelegramMiniApp();
  initializeData();
  execGTagEvent("returninguser_enter", { pts: creditsBalance.value.toString(), from: from || "unknown" } as AnyObject);
});
onUnmounted(() => {
  execGTagEvent("returninguser_leave", { pts: creditsBalance.value.toString() } as AnyObject);
});
</script>

