              </view>
              <view class="welcome-countdown">
                <text class="welcome-countdown-item">{{ calculateTimeRemaining(createdTime).days }}</text>
                {{ $i18n_t("user_return.time_left_day") }}
                <text class="welcome-countdown-item">{{ calculateTimeRemaining(createdTime).hours }}</text>
                {{ $i18n_t("user_return.time_left_hour") }}
                <text class="welcome-countdown-item">{{ calculateTimeRemaining(createdTime).minutes }}</text>
                {{ $i18n_t("user_return.time_left_minute") }}
              </view>
            </view>
            <view class="welcome-box2">
              <view class="welcome-title4">{{ $i18n_t("user_return.unique_reward") }}</view>
              <view class="welcome-title5">{{ $i18n_t("user_return.welcome_point") }}</view>
              <view class="welcome-points">
                <image class="welcome-points-flash-icon" src="/static/icons/flash@2x.png" />
                {{ baseRewardData?.point || 0 }}
              </view>
              <view class="welcome-title6">{{ $i18n_t("user_return.welcome_point_desc") }}</view>
              <view
                :class="['welcome-btn', baseRewardData?.status === 2 ? '' : 'welcome-btn-claim']"
                @click="() => baseRewardData?.status === 1 && handleTaskClick(baseRewardData)"
              >
                <fr-spin type="primary" style="position: absolute; left: 42%; top: 21%" v-if="baseRewardData.loading" />
                <image class="welcome-btn-gift-icon" src="/static/gift.png" />
                <text class="welcome-btn-text">{{ baseRewardData?.status === 2 ? $i18n_t("user_return.btn_claimed") : $i18n_t("user_return.btn_claim") }}</text>
              </view>
            </view>
          </view>
          <view class="tabs">
            <view class="tabs-header">
              <view class="tab-item" :class="{ 'tab-active': activeTab === 'tasks' }" @click="switchTab('tasks')">
                <text>{{ $i18n_t("user_return.tab_title1") }}</text>
                <view class="tab-indicator" v-if="activeTab === 'tasks'"></view>
              </view>
              <view class="tab-item" :class="{ 'tab-active': activeTab === 'rewards' }" @click="switchTab('rewards')">
                <text>{{ $i18n_t("user_return.tab_title2") }}</text>
                <view class="tab-indicator" v-if="activeTab === 'rewards'"></view>
              </view>
            </view>
            <view class="tabs-content">
              <view v-if="activeTab === 'tasks'" class="tab-invite-task">
                <view class="invite-task-title">
                  <image class="invite-user-icon" src="/static/invite-user.png" />
                  <text>{{ $i18n_t("user_return.tab_title1") }}</text>
                </view>
                <view class="invite-task-progress">
                  <view class="invite-task-progress-title">
                    <text class="invite-task-progress-title-text1">{{ $i18n_t("user_return.invite_progress") }}</text>
                    <text class="invite-task-progress-title-text2">{{ $i18n_t("user_return.invite_progress_desc", { num: requiredCount }) }}</text>
                  </view>
                  <view class="invite-task-progress-point">
                    <view class="invite-task-progress-point-bar1"></view>
                    <view class="invite-task-progress-point-bar2"></view>
                    <view class="invite-task-progress-point-bar3"></view>
                    <view v-for="(item, index) in swapLastTwoItems(list)" :key="index" class="invite-task-progress-point-item">
                      <view v-if="item.status === 2" class="invite-task-progress-point-item-icon1">
                        <image class="invite-task-progress-point-item-icon1-success" src="/static/success-icon.png" />
                      </view>
                      <view v-else class="invite-task-progress-point-item-icon2">
                        <image class="invite-task-progress-point-item-icon2-user" src="/static/user-icon.png" />
                      </view>
                      <text class="invite-task-progress-point-item-title">{{
                        item.rewardLevel === 0 ? $i18n_t("user_return.step_start") : $i18n_t("user_return.step_num", { num: item.requairedNum })
                      }}</text>
                      <text class="invite-task-progress-point-item-subtitle">{{ item.point }}{{ $i18n_t("user_return.points") }}</text>
                    </view>
                  </view>
                </view>
                <view class="invite-task-tips">
                  <text class="invite-task-tips-icon">!</text>
                  <text class="invite-task-tips-text">{{ $i18n_t("user_return.tips") }}</text>
                </view>
                <view class="invite-task-copy">
                  <view class="invite-task-copy-title">{{ $i18n_t("user_return.link") }}</view>
                  <view class="invite-task-copy-content">
                    <text class="invite-task-copy-content-text">{{ shareLink }}</text>
                    <view class="invite-task-copy-content-btn" @click="copyToClipboard(shareLink)">{{ $i18n_t("user_return.copy") }}</view>
                  </view>
                  <view class="invite-task-copy-subtitle">{{ $i18n_t("user_return.link_desc") }}</view>
                </view>
                <view class="invite-task-copy">
                  <view class="invite-task-copy-title">{{ $i18n_t("user_return.code") }}</view>
                  <view class="invite-task-copy-content">
                    <text class="invite-task-copy-content-text">
                      {{ $i18n_t("user_return.code_desc1") }}
                      <text class="invite-task-copy-content-text-code">{{ inviteCode }}</text>
                    </text>
                    <view class="invite-task-copy-content-btn" @click="copyToClipboard(inviteCode)">{{ $i18n_t("user_return.copy") }}</view>
                  </view>
                  <view class="invite-task-copy-subtitle">{{ $i18n_t("user_return.code_desc2") }}</view>
                </view>
                <view class="invite-task-reward">
                  <view class="invite-task-reward-title">
                    <image class="invite-task-reward-title-icon" src="/static/rewards-icon.png" />
                    <view class="invite-task-reward-title-text">{{ $i18n_t("user_return.reward_title1") }}</view>
                  </view>
                  <view class="invite-task-reward-list">
                    <view class="invite-task-reward-item" v-for="(item, index) in list" :key="index">
                      <text class="invite-task-reward-item-title">
                        {{ item.rewardLevel === 0 ? $i18n_t("user_return.reward_title2") : $i18n_t("user_return.reward_title3", { num: item.requairedNum }) }}
                      </text>
                      <text class="invite-task-reward-item-num">{{ item.point }}</text>
                      <text class="invite-task-reward-item-subtitle">
                        <text class="invite-task-reward-item-subtitle-zero" v-if="item.rewardLevel === 0">{{ $i18n_t("user_return.btn_claim_now") }}</text>
                        <template v-else>{{ $i18n_t("user_return.reward_title3", { num: item.requairedNum }) }}</template>
                      </text>
                      <view v-if="item.status === 0" class="invite-task-reward-item-btn0">{{ $i18n_t("user_return.btn_unmet") }}</view>
                      <view v-if="item.status === 1" class="invite-task-reward-item-btn1" @click="() => handleTaskClick(item)">
                        <fr-spin type="primary" style="position: absolute; left: 42%; top: 21%" v-if="item.loading" />
                        {{ $i18n_t("user_return.btn_claim") }}
                      </view>
                      <view v-if="item.status === 2" class="invite-task-reward-item-btn2">{{ $i18n_t("user_return.btn_claimed") }}</view>
                    </view>
                  </view>
                </view>
              </view>
              <view v-if="activeTab === 'rewards'" class="tab-invite-history">
                <view class="tab-invite-history-title">
                  <image class="tab-invite-history-title-icon" src="/static/invite-icon.png" />
                  <text class="tab-invite-history-title-text">{{ $i18n_t("user_return.tab_title2") }}</text>
                </view>
                <view class="tab-invite-history-item" v-for="(item, index) in history" :key="index">
                  <image class="tab-invite-history-item-left" :src="item.avatar || '/static/defaultAvatar.png'"></image>
                  <view class="tab-invite-history-item-right">
