<template>
  <bp-navigation-bar-title>
    <PCSideBar>
      <scroll-view class="container" direction="vertical" @scrolltolower="loadMoreHistory">
        <view class="container-content">
          <view class="header">
            <view class="header-arrow-left" @click="goBack()">
