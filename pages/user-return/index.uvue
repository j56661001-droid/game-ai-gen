                    <text class="tab-invite-history-item-right-title2"
                      >{{ $i18n_t("user_return.register_email") }}{{ item.status === "rewarded" ? item.emailAddress : $i18n_t("user_return.no_email") }}</text
                    >
                    <text class="tab-invite-history-item-right-title3">{{ $i18n_t("user_return.register_time") }}{{ item.createdAt.split("T")[0] }}</text>
                    <view class="tab-invite-history-item-right-btn1" v-if="item.emailVerified">{{ $i18n_t("user_return.email_linked") }}</view>
                    <view class="tab-invite-history-item-right-btn2" v-else>{{ $i18n_t("user_return.email_unlinked") }}</view>
                  </view>
                </view>
                <!-- 兜底显示 -->
                <view v-if="history.length === 0" class="tab-invite-history-empty">
                  <text class="tab-invite-history-empty-text">{{ $i18n_t("user_return.no_history") }}</text>
