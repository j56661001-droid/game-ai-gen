<template>
  <bp-navigation-bar-title>
    <PCSideBar>
      <view class="affiliate-page">
        <image class="background-image" src="/static/affiliate_header.png"></image>
        <!-- Navigation Bar -->
        <view class="nav-bar">
          <view class="back-button" @click="goBack()">
            <IconFont name="arrowleft" :size="19" color="#fff"></IconFont>
          </view>
          <text class="nav-title">{{ $i18n_t("affiliate.title") }}</text>
          <credits-balance-icon class="credits-balance points"></credits-balance-icon>
        </view>

        <!-- Header Stats -->
        <view class="header-stats">
          <view class="stat-item">
            <text class="stat-value">{{ affiliateInfo.stats?.totalReferralPoints ?? 0 }}</text>
            <text class="stat-label">{{ $i18n_t("affiliate.totalPoints") }}</text>
          </view>
          <view class="divider"></view>
          <view class="stat-item">
            <text class="stat-value">{{ affiliateInfo.stats?.successfulInvites ?? 0 }}</text>
            <text class="stat-label">{{ $i18n_t("affiliate.successfulInvites") }}</text>
          </view>
          <!-- <view class="divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{ affiliateInfo.stats?.pendingInvites ?? 0 }}</text>
          <text class="stat-label">{{ $i18n_t("affiliate.pendingUnlock") }}</text>
        </view> -->
        </view>

        <scroll-view class="content-scroll" scroll-y @scrolltolower="loadMoreHistory">
          <!-- Referral Tools -->
          <view class="tool-card">
            <text class="card-title">{{ $i18n_t("affiliate.myReferralTool") }}</text>
            <view class="referral-code-section">
              <view class="qr-code" ref="qrcodeContainerRef"></view>
              <template v-if="!isTgMiniApp">
                <view class="code-info">
                  <text class="code">{{ affiliateInfo.referralCode }}</text>
                  <text class="code-desc">{{ $i18n_t("affiliate.enterCodeOnRegister") }}</text>
                </view>
                <view class="copy-icon-wrapper" @click="copyInviteCode">
                  <image src="/static/icons/copy.png" class="copy-icon"></image>
                </view>
              </template>
              <button v-else class="share-button-in-card" @click="handleShare">{{ $i18n_t("affiliate.share") }}</button>
            </view>
            <view class="referral-link-section">
              <text class="link-text">{{ shareLink }}</text>
              <button class="copy-button" @click="copyReferralLink">{{ $i18n_t("affiliate.copy") }}</button>
            </view>
            <!-- <view class="share-buttons">
            <view class="share-icon-wrapper">
              <IconFont name="share" :size="24" color="#fff"></IconFont>
            </view>
            <view class="share-icon-wrapper">
              <IconFont name="share" :size="24" color="#fff"></IconFont>
            </view>
            <view class="share-icon-wrapper">
              <IconFont name="share" :size="24" color="#fff"></IconFont>
            </view>
            <view class="share-icon-wrapper">
              <IconFont name="share" :size="24" color="#fff"></IconFont>
            </view>
          </view> -->
          </view>

          <!-- Reward Rules -->
          <view class="reward-card">
            <text class="card-title">{{ $i18n_t("affiliate.rewardRules") }}</text>
            <view class="reward-list">
              <view class="reward-item" v-for="(rule, index) in affiliateInfo.rules" :key="index">
                <view style="max-width: calc(100% - 50px)">
                  <text class="reward-title">{{ fmtBackendLang(rule.title) }}</text>
                  <text class="reward-desc">{{ fmtBackendLang(rule.description) }}</text>
                </view>
                <text class="reward-points">+{{ rule.rewardPoints }}</text>
              </view>
            </view>
          </view>

          <!-- Invitation History -->
          <view class="history-card">
            <view class="history-header">
              <text class="card-title">{{ $i18n_t("affiliate.invitationHistory") }}</text>
            </view>
            <view class="history-list">
              <view class="history-item" v-for="(item, index) in history" :key="index">
                <image class="avatar" :src="item.avatar || '/static/defaultAvatar.png'"></image>
                <view class="user-info">
                  <text class="username">{{ item.inviteeUsernameMasked }}</text>
                  <text class="date">{{ item.createdAt }}</text>
                </view>
                <text v-if="item.status === 'rewarded'" class="status rewarded">+{{ rewardedPointsComputed }}</text>
                <text v-else class="status pending_verification">{{ $i18n_t("affiliate.status.pending_verification") }}</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </PCSideBar>
  </bp-navigation-bar-title>
</template>

<script setup lang="ts">
import { ref, onMounted, computed } from "vue";
import IconFont from "@/components/IconFont/IconFont.uvue";
import CreditsBalanceIcon from "../publish/panel/credits-balance-icon.uvue";
import { onBackPress } from "@dcloudio/uni-app";
import { $i18n_t, fmtBackendLang } from "@/locale/index.uts";
import { getAffiliateSummary, getAffiliateHistory } from "@/api/affiliate.uts";
import { getDomainFromUrl, isTelegramMiniApp } from "@/utils/platform.uts"; // Import isTelegramMiniApp
import { config } from "@/api/request.uts";
import type { ReferralCenterData, InvitationHistoryItem } from "@/types/affiliate.uts";
import { goBack } from "@/utils/page";
import { appStore } from "@/store/index.uts"; // Import appStore
import { creditsBalance } from "@/store/user.uts";
import { execGTagEvent } from "@/utils/index.uts";
import BpNavigationBarTitle from "@/components/panels/bp-navigation-bar-title.uvue";
import PCSideBar from "@/components/PCSideBar/index.uvue";
// Declare QRCode globally
declare var QRCode: any;

const qrcodeContainerRef = ref<HTMLElement | null>(null);

const affiliateInfo = ref<ReferralCenterData>({
  referralCode: "",
  rules: [],
  stats: {
    pendingInvites: 0,
    successfulInvites: 0,
    totalReferralPoints: 0,
  },
});

const history = ref<InvitationHistoryItem[]>([]);
const page = ref(1);
const pageSize = 20;
const loading = ref(false);
const hasMore = ref(true);
const shareLink = ref("");

const isTgMiniApp = ref<boolean>(false); // Reactive variable for Telegram Mini App status

const rewardedPointsComputed = computed(() => {
  if (affiliateInfo.value.rules.length > 0) {
    return affiliateInfo.value.rules[0].rewardPoints;
  }
  return 0; // Default value if no rules are found
});

const effectiveDomain = computed(() => {
  if (typeof window !== "undefined" && window.location && window.location.protocol) {
    const protocol = window.location.protocol;
    if (protocol === "http:" || protocol === "https:") {
      return `${protocol}//${window.location.hostname}`;
    }
  }
  return getDomainFromUrl(config.baseUrl); // Fallback for non-browser environments or if window is undefined
});

const generateQRCode = (text: string) => {
  if (typeof window !== "undefined" && typeof QRCode !== "undefined" && qrcodeContainerRef.value != null) {
    try {
      qrcodeContainerRef.value.innerHTML = ""; // Clear existing QR code

      new QRCode(qrcodeContainerRef.value, {
        text: text,
        width: 80,
        height: 80,
        colorDark: "#000000",
        colorLight: "#ffffff",
        correctLevel: QRCode.CorrectLevel.L,
      });
    } catch (e) {
      console.error("QR code generation failed:", e);
    }
  } else {
    console.warn("QRCode library not available or not in web environment.");
  }
};

const copyReferralLink = () => {
  uni.setClipboardData({
    data: shareLink.value,
    success: () => {
      uni.showToast({
        title: $i18n_t("affiliate.copySuccess"),
        icon: "none",
      });
    },
  });
};

const copyInviteCode = () => {
  uni.setClipboardData({
    data: affiliateInfo.value.referralCode,
    success: () => {
      uni.showToast({
        title: $i18n_t("affiliate.inviteCodeCopySuccess"),
        icon: "none",
      });
    },
  });
};

const handleShare = () => {
  uni.$emit("debug:log", `Affiliate handleShare called. isTgMiniApp.value: ${isTgMiniApp.value}`);
  if (isTgMiniApp.value) {
    uni.$emit("debug:log", `botUsername: ${appStore.value.botUsername}`);
    uni.$emit("debug:log", `appName: ${appStore.value.appName}`);
    if (window.Telegram?.WebApp && appStore.value.botUsername && appStore.value.appName) {
      const inviteLink = `https://t.me/${appStore.value.botUsername}/${appStore.value.appName}?startapp=${affiliateInfo.value.referralCode}`;
      // const shareText = $i18n_t("affiliate.shareText"); // Assuming this i18n key exists

      const fullUrl = `https://t.me/share/url?url=${encodeURIComponent(inviteLink)}`; //&text=${encodeURIComponent(shareText)}
      uni.$emit("debug:log", `Affiliate Telegram share. inviteLink: ${inviteLink}, fullUrl: ${fullUrl}`);
      window.Telegram.WebApp.openTelegramLink(fullUrl);
    } else {
      uni.$emit(
        "debug:log",
        `Affiliate Telegram share failed: Missing Telegram WebApp or appStore info. botUsername: ${appStore.value.botUsername}, appName: ${appStore.value.appName}`,
      );
    }
  } else {
    uni.$emit("debug:log", `Affiliate handleShare: Not a Telegram Mini App. Showing generic toast.`);
    uni.showToast({
      title: $i18n_t("affiliate.telegramShareNotAvailable"), // Placeholder message
      icon: "none",
    });
  }
};

const fetchData = async () => {
  try {
    page.value = 1;
    hasMore.value = true;
    loading.value = true;
    const [summary, historyData] = await Promise.all([getAffiliateSummary(), getAffiliateHistory(page.value, pageSize)]);
    affiliateInfo.value = summary.data;

    // Conditionally generate shareLink based on Telegram Mini App environment
    uni.$emit(
      "debug:log",
      `Affiliate fetchData: Before shareLink generation. isTgMiniApp.value: ${isTgMiniApp.value}, botUsername: ${appStore.value.botUsername}, appName: ${appStore.value.appName}`,
    );
    if (isTgMiniApp.value && appStore.value.botUsername && appStore.value.appName) {
      shareLink.value = `https://t.me/${appStore.value.botUsername}/${appStore.value.appName}?startapp=${affiliateInfo.value.referralCode}`;
    } else {
      shareLink.value = `${effectiveDomain.value}/pages/index/index?promotional_code=${affiliateInfo.value.referralCode}`;
    }
    uni.$emit("debug:log", `Affiliate fetchData: shareLink generated: ${shareLink.value}`);

    history.value = historyData.data;
    hasMore.value = historyData.meta.pagination.has_next;
    generateQRCode(shareLink.value);
  } catch (error) {
    console.error("Failed to fetch affiliate data:", error);
    uni.$emit("debug:log", `Affiliate fetchData error: ${error}`);
  } finally {
    loading.value = false;
  }
};

const loadMoreHistory = async () => {
  if (loading.value || !hasMore.value) {
    return;
  }
  loading.value = true;
  page.value++;
  try {
    const res = await getAffiliateHistory(page.value, pageSize);
    const newHistory = res.data;
    history.value.push(...newHistory);
    hasMore.value = res.meta.pagination.has_next;
  } catch (error) {
    console.error("Failed to fetch more history:", error);
    page.value--; // revert page increase on error
  } finally {
    loading.value = false;
  }
};

onMounted(() => {
  isTgMiniApp.value = isTelegramMiniApp(); // Set Telegram Mini App status on mount
  uni.$emit("debug:log", `Affiliate page mounted. isTgMiniApp.value: ${isTgMiniApp.value}`);
  fetchData();

  execGTagEvent("c2c_enter", { pts: creditsBalance.value.toString() } as AnyObject);
});

onUnmounted(() => {
  execGTagEvent("c2c_leave", { pts: creditsBalance.value.toString() } as AnyObject);
});

onBackPress(() => {
  // You can handle the back button logic here
  console.log("back button pressed");
  return false; // Return false to perform the default back operation
});
</script>

