  color: #ff6b6b;
}

.image-uploader {
  width: 100%;
}

.feedback-type-selector {
  width: 100%;
  margin-top: 8px;
}

.submit-section {
  margin-top: 32px;
  padding: 0 16px 20px;
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  /* padding-bottom: 20px; */
}

/* 历史记录tab内容 */
.history-tab-content {
  flex: 1;
}

.history-list-content {
  padding: 0 16px;
}

.history-list {
  flex: 1;
  height: 100%;
}

.history-item {
  padding: 16px;
  background-color: #1a1a1a;
  border-radius: 12px;
  margin-bottom: 12px;
}

/* 第一行：标签、状态和日期时间 */
.history-top-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
}

.history-type-tag {
  padding: 4px 8px;
  border-radius: 4px;
  flex-shrink: 0;
  margin-right: 12px;
}

.tag-complaint {
  background-color: rgba(244, 67, 54, 0.2);
}

.tag-suggestion {
  background-color: rgba(76, 175, 80, 0.2);
}

.tag-text {
  font-size: 12px;
  font-weight: 600;
}

.tag-complaint .tag-text {
  color: #F44336;
}

.tag-suggestion .tag-text {
  color: #4CAF50;
}

.history-status {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-right: 12px;
}

.status-text {
  font-size: 12px;
  color: #707070;
}

.history-date {
  font-size: 12px;
