<script setup lang="uts">
import { $i18n_t } from "@/locale/index.uts";
import FrSpin from "@/components/widgets/fr-spin.uvue";

type Props = {
  disabled?: boolean;
  loading?: boolean;
  block?: boolean;
  completed?: boolean;
  text?: string;
};

const props = defineProps<Props>();

const emit = defineEmits<{
  (e: 'click'): void;
}>();

const handleClick = () => {
  emit('click');
};
</script>

<template>
  <view class="checkin-button-container">
    <button 
      class="button-container" 
      :class="{ 'checkin-completed': completed, 'disabled': disabled }" 
      :disabled="disabled"
      @click="handleClick"
    >
      <fr-spin v-if="loading" class="loading" :size="20" />

      <view v-if="completed" class="completed-container">
        <text class="completed-text">
          {{ $i18n_t("dailyCheckin.buttonCompleted") }}
          <image src="/static/icons/party-popper@2x.png" class="party-popper" mode="widthFix" />
        </text>
        <text class="update-tips">
          {{ $i18n_t("dailyCheckin.taskUpdateTomorrow") }}
        </text>
      </view>
      <text v-else class="button-text">{{ text || $i18n_t("dailyCheckin.buttonSignIn") }}</text>
    </button>
  </view>
</template>

