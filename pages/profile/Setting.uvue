<template>
  <bp-navigation-bar-title>
    <view class="container">
      <!-- 顶部导航栏 -->
      <view class="header">
        <view class="header-row">
          <IconFont name="arrowleft" :size="16" color="#ffffff" style="margin-right: 16px" @click="goBack()" :btnSize="30"></IconFont>
          <text class="title">{{ settingText }}</text>
        </view>
      </view>

      <view class="list-container">
        <view v-for="(item, index) in (menuItems as MenuItem[])" :key="index" class="list-item" @click="onItemClick(item)">
          <view class="item-left">
            <image :src="item.icon" class="icon" mode="aspectFit"></image>
            <text class="item-text">{{ item.text }}</text>
          </view>
          <view class="item-right">
            <!-- 邮箱项特殊处理 -->
            <view v-if="item.text == $i18n_t('profile.email')" style="display: flex; flex-direction: row; align-items: center; gap: 8px">
              <!-- 如果已绑定邮箱，显示邮箱地址 -->
              <text v-if="hasEmail" class="email-text">{{ user?.email }}</text>
              <!-- 如果未绑定邮箱，显示粉色按钮 -->
              <text v-else class="verify-button">
                <template v-if="awardPoints == 0">{{ $i18n_t("profile.verifyNow") }}</template>
                <template v-else>{{ $i18n_t("profile.verifyEmailAndGetAward") }}</template>
              </text>
              <IconFont name="arrowright" :size="10" :opacity="0.5" />
            </view>
            <!-- 其他项正常显示箭头 -->
            <IconFont v-else-if="item.text != $i18n_t('profile.logOut')" name="arrowright" :size="10" :opacity="0.5" />
          </view>
        </view>
      </view>
    </view>
    <view class="version">
      <text class="version-text">{{ versionText }}</text>
    </view>
    <BindEmailModal :visible="showBindEmailModal" @close="showBindEmailModal = false" @success="showBindEmailModal = false" />
  </bp-navigation-bar-title>
</template>

<script setup lang="uts">
import { computed, ref } from "vue";
import IconFont from "@/components/IconFont/IconFont.uvue";
import { postLogout } from "@/api/user.uts";
import { logout, user } from "@/store/user.uts";
import { $i18n_t } from "@/locale/index.uts";
import i18n from "@/locale/index.uts";
import { goBack } from "@/utils/page";
import BpNavigationBarTitle from "@/components/panels/bp-navigation-bar-title.uvue";
import BindEmailModal from "@/components/account/bind-email-modal.uvue";
import { getSettings } from "@/api/file.uts"; // Import getSettings
import { onMounted } from "vue"; // Import onMounted
import { isTelegramMiniApp } from "@/utils/platform.uts"; // Import isTelegramMiniApp

const settingText = computed(() => $i18n_t("profile.setting"));

const versionText = computed(() => {
  return "version: " + uni.getAppBaseInfo().appVersion;
});

const awardPoints = ref<number>(0); // 新增：用于存储绑定成功后的奖励积分

// 控制绑定邮箱弹窗的显示
const showBindEmailModal = ref(false);

// 判断用户是否已绑定邮箱
const hasEmail = computed(() => {
  return user.value != null && user.value.email != null && user.value.email != "";
});

// 定义菜单项的数据结构
type MenuItem = {
  icon: string;
  text: string;
  path?: string; // 可选，用于跳转
  action?: string;
};

// 使用 ref 创建响应式的菜单项数组
const menuItems = computed<MenuItem[]>(() => {
  i18n.global.locale.value;
  const items: MenuItem[] = [
    { icon: "/static/icons/profile@2x.png", text: $i18n_t("profile.profileInfo"), path: "/pages/profile/ProfileInfo" },
    { icon: "/static/icons/lang@2x.png", text: $i18n_t("profile.language"), path: "/pages/profile/Language" },
    { icon: "/static/icons/region@2x.png", text: $i18n_t("profile.region"), path: "/pages/profile/RegionSetting" },
    { icon: "/static/icons/policy@2x.png", text: $i18n_t("profile.privacyPolicy"), path: "/pages/profile/PrivacyPolicy" },
    { icon: "/static/icons/terms@2x.png", text: $i18n_t("profile.termsOfService"), path: "/pages/profile/TermsOfService" },
  ];

  if (!isTelegramMiniApp()) {
    items.push({
      icon: "/static/icons/logout@2x.png",
      text: user.value?.accountType == "guest" ? $i18n_t("common.register") : $i18n_t("profile.logOut"),
      action: user.value?.accountType == "guest" ? "register" : "logout",
    });
  }

  if (user.value != null) {
    //|| user.value.accountType != 'guest'
    items.splice(1, 0, { icon: "/static/icons/email@2x.png", text: $i18n_t("profile.email"), path: "/pages/profile/ChangeEmail" });

    // 添加反馈与投诉项（放在倒数第二个位置）
    items.splice(items.length - (isTelegramMiniApp() ? 0 : 1), 0, {
      icon: "/static/icons/feedback.png",
      text: $i18n_t("profile.feedback"),
      path: "/pages/feedback/index",
    });
  }

  return items;
});

// 列表项点击事件处理函数
const onItemClick = async (item: MenuItem) => {
  if (item.text == $i18n_t("profile.email")) {
    if (hasEmail.value) {
      if (item.path != null) {
        uni.navigateTo({ url: item.path });
      }
    } else {
      // 未绑定邮箱
      if (user.value == null) {
        //?.accountType == 'guest'
        uni.$emit("login:show");
      } else {
        // 如果不是游客，显示绑定邮箱弹窗
        showBindEmailModal.value = true;
      }
    }
  } else if (item.path != null) {
    // 反馈页需登录，进入前拦截并弹出登录弹窗
    if (item.path === "/pages/feedback/index" && (user.value == null || user.value?.accountType === "guest")) {
      uni.$emit("login:show", { to: "/pages/feedback/index", successRedirectOnly: true });
      return;
    }
    uni.navigateTo({ url: item.path });
  } else if (item.action == "logout") {
    let res = await postLogout();
    if (res != null && res.success) {
      logout();
    }
  } else if (item.action == "register") {
    uni.navigateTo({ url: "/pages/account/register" }); // Assuming a Register page exists
  }
};

onMounted(async () => {
  const response = await getSettings("verification_award");
  if (response != null && response.success && response.data != null) {
    awardPoints.value = Number(response.data.value);
  }
});
</script>

<style scoped>
/* 页面整体容器 */
.container {
  display: flex;
  flex-direction: column;
  height: 100%;
  max-width: 1400px;
  width: 100%;
  margin: 0 auto;
  background-color: #000000;
  color: #ffffff;
}

/* 顶部区域 */
.header {
  display: flex;
  flex-direction: column;
  margin-top: 20px;
  min-height: 58px;
  padding: 12px 16px;
}

.header-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
}

.title {
  flex: 1;
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  margin-right: 16px;
}

.list-container {
  padding: 0 15px; /* 左右内边距 */
  box-sizing: border-box;
  padding-top: 10px;
}

/* 列表项样式 */
.list-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between; /* 两端对齐 */
  align-items: center; /* 垂直居中 */
  padding: 18px 5px; /* 上下内边距 */
}

/* 列表项左侧容器 */
.item-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

/* 列表项右侧容器 */
.item-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
}

/* 图标样式 */
.icon {
  width: 20px;
  height: 20px;
  margin-right: 15px; /* 图标与文字的间距 */
}

/* 文字样式 */
.item-text {
  color: #ffffff;
  font-size: 14px;
  line-height: 1.5; /* Ensure sufficient line height for vertical display */
}

/* 邮箱文本样式 */
.email-text {
  color: #707070;
  font-size: 14px;
}

/* 验证按钮样式 */
.verify-button {
  background-color: #ff69b4; /* 粉色背景 */
  color: #ffffff;
  font-size: 14px;
  padding: 4px 12px;
  border-radius: 12px;
  font-weight: bold;
}

.version {
  position: absolute;
  width: 100%;
  bottom: 10px;
  left: 10px;
  right: 10px;
}

.version-text {
  color: #707070;
}
</style>
