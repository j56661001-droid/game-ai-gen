  scale: 0.5; 
  position: absolute;
  top: -130px; 
  
}

.username {
  font-size: 24px;
  font-weight: bold;
  color: #fff;
  
  margin-bottom: 10px;
}

.likes-count {
  font-size: 20px;
  color: #fff;
