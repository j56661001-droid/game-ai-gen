<template>
  <view class="mask" @click="handleMaskClick">
    <view class="popup-container">
      <image class="likestar-icon" mode="aspectFit" src="/static/icons/likestar@2x.png"></image>
      <view class="content-wrapper">
        <text class="username">{{ username }}</text>
        <text class="likes-count">{{ photoLikeCount }}</text>
        <text class="desc">{{ likesReceivedFromImageText }}</text>
        <view class="divider"></view>
        <text class="likes-count">{{ videoLikeCount }}</text>
        <text class="desc">{{ likesReceivedFromVideoText }}</text>
        <button class="got-it-button" @click="handleGotItClick">{{ gotItText }}</button>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue';
import { $i18n_t } from "@/locale/index.uts";

const likesReceivedFromImageText = computed(() => $i18n_t("profile.likesReceivedFromImage"));
const likesReceivedFromVideoText = computed(() => $i18n_t("profile.likesReceivedFromVideo"));
const gotItText = computed(() => $i18n_t("profile.gotIt"));

// 定义组件 props
type Props = {
  username: string;
  videoLikeCount: number;
  photoLikeCount: number;
};

const props = defineProps<Props>();

const emit = defineEmits(['close']);

const handleMaskClick = (event: UniPointerEvent) => {
  if (event.target == event.currentTarget) {
    emit('close');
  }
};

const handleGotItClick = () => {
  emit('close');
};
</script>

