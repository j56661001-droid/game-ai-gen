<template>
  <slot :count="count" :updated="recordUpdated">
    <view class="record-icon-container">
      <fr-badge :dot="recordUpdated" :count="count" count-class="badge-count">
        <icon-font name="order_outlined" :size="18" class="record-icon" @click="onGotoProcessingRecords" />
      </fr-badge>
    </view>
  </slot>
</template>

<script setup lang="uts">
import { FrBadge } from "@/components/widgets/index.uts";
import IconFont from "@/components/IconFont/IconFont.uvue";
import { useLoadDataRequest, LoadDataRequestOptions } from "@/hooks";
import { user } from "@/store/user";

const intervalFlag = ref<number | null>(null);
const recordUpdated = ref<boolean>(false);

const { loadDataRequest, result } = useLoadDataRequest({
  url: `ai-generations/history`,
  customErrorHanlder: () => {},
} as LoadDataRequestOptions);

const count = computed((): number => {
  const total = result.meta?.pagination?.total;
  return total != null ? total : 0;
});

watch(
  () => result.meta?.pagination,
  (p, prevP) => {
    if (prevP != null && p.total != prevP.total) {
      recordUpdated.value = true;
    }
  },
);

const loadData = () => {
  if (user.value != null) {
    loadDataRequest({ page: 1, size: 1, status: ["completed"] });
  }
};

onMounted(() => {
  loadData();

  intervalFlag.value = setInterval(() => {
    loadData();
  }, 1000 * 5); // 5s
});

onUnmounted(() => {
  if (intervalFlag.value != null) {
    clearInterval(intervalFlag.value);
    intervalFlag.value = null;
  }
});

const onGotoProcessingRecords = () => {
  recordUpdated.value = false;
  uni.navigateTo({ url: "/pages/publish/processing-records" });
};
</script>

<style scoped>
.record-icon-container {
  width: 40px;
  height: 40px;
  background-color: #1f1f1f;
  border-radius: 20px;
  align-items: center;
  justify-content: center;
}

.record-icon-container uni-view {
  overflow: unset;
}

.record-icon {
  color: #fff;
}

.fr-badge :deep(.badge-count) {
  top: -10px;
  right: -10px;
}
</style>
