  background-color: #c8e6c9;
}

.notice-title {
  font-size: 14px;
  font-weight: bold;
  margin-bottom: 4px;
  line-height: 1.4;
}

.notice-container.yellow .notice-title {
  color: #ffa000;
}

.notice-container.green .notice-title {
  color: #2e7d32;
}

.notice-desc {
  font-size: 12px;
  color: #ffffff;
  line-height: 1.4;
  white-space: pre-line;
}

.readonly-field {
  background-color: #262626;
  padding: 12px 16px;
  border-radius: 8px;
  margin-bottom: 20px;
}

.readonly-input {
  width: 100%;
  height: 48px;
  background-color: #262626;
  border-radius: 24px;
  padding: 0 16px;
  align-items: left;;
}

.readonly-text {
  font-size: 14px;
  color: #fff;
  line-height: 48px;
  text-align: left;
}

.field-label {
  font-size: 14px;
  color: rgba(255,255,255,0.6);
  margin-bottom: 6px;
}

.field-value {
  font-size: 14px;
  color: #fff;
  margin-top: 4px;
}

.input-container,
.verification-container {
  width: 100%;
  margin-bottom: 16px;
  position: relative;
}


.password-input,
.email-input,
.code-input {
  width: 100%;
  height: 48px;
  background-color: #262626;
  border-radius: 24px;
  padding: 0 16px;
  font-size: 14px;
  color: #fff;
}

.error-text {
  font-size: 12px;
  color: #ff4757;
  margin-top: 6px;
  text-align: left;
}

.resend-container {
  position: absolute;
  top: 50%;
  right: 50px;
  height: 100%;
}

.resend-text {
  font-size: 14px;
  color: #ff23b8;
}

.tip-text {
  font-size: 14px;
  color: rgba(255,255,255,0.8);
  margin: 8px 0 24px;
  line-height: 1.4;
}

.tip-text.important {
  color: #e91e63;
}

.tip-text.security {
  color: #f57c00;
}

.info-item {
  flex-direction: row;
  margin-bottom: 12px;
  padding: 0 16px;
}

.info-label {
  font-size: 14px;
  color: rgba(255,255,255,0.8);
  min-width: 80px;
}

.info-value {
  font-size: 14px;
  color: #fff;
  flex: 1;
}

.button-container {
  flex-direction: row;
  justify-content: space-between;
  width: 100%;
  position: absolute;
  bottom: 24px;
  left: 0;
}

.button-container.single-button {
  justify-content: center;
}

.button {
  padding: 0 24px;
