<template>
  <view class="generic-modal-page">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-header-title">{{ modalTitle }}</text>
        <view v-if="true" class="close-button" @click="closeModal">
          <IconFont name="close" :size="12" color="#333"></IconFont>
        </view>
      </view>
      <text class="modal-title-text">
        {{ mainMessage }}
      </text>
      <text class="modal-sub-text">{{ subMessage }}</text>
      <view class="modal-buttons-container">
        <button v-if="showCancelButton" class="modal-button cancel-button" @click="onCancelClick">{{ cancelText }}</button>
        <button v-if="true" class="modal-button register-button" @click="onRegisterClick">{{ confirmText }}</button>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted, computed } from "vue";
import { parseNumToThousands } from "@/utils/parse.uts";
import { appStore, setTopUpSuccessModalData } from "@/store/index.uts"; // Import appStore and setTopUpSuccessModalData

const modalData = computed(() => appStore.value.topUpSuccessModalData);

const modalTitle = computed(() => modalData.value?.modalTitle || "");
const mainMessage = computed(() => modalData.value?.mainMessage || "");
const subMessage = computed(() => modalData.value?.subMessage || "");
const confirmText = computed(() => modalData.value?.confirmText || "确认");
const onConfirmCallback = computed(() => modalData.value?.onConfirm || undefined);
const cancelText = computed(() => modalData.value?.cancelText || "取消"); // New: cancelText computed property
const onCancelCallback = computed(() => modalData.value?.onCancel || undefined); // New: onCancelCallback computed property

const showCancelButton = computed(() => !!cancelText.value && !!onCancelCallback.value); // New: showCancelButton computed property

const closeModal = () => {
  // Instead of closing directly, invoke onCancelCallback if available,
  // which is handled by the parent (App.uvue) to close the dialog.
  if (onCancelCallback.value) {
    onCancelCallback.value();
  }
};

const onRegisterClick = () => {
  if (onConfirmCallback.value) {
    onConfirmCallback.value();
  }
  // The modal is closed by the callback itself, no direct action here
};

const onCancelClick = () => {
  if (onCancelCallback.value) {
    onCancelCallback.value();
  }
  // The modal is closed by the callback itself, no direct action here
};
</script>

<style scoped>
