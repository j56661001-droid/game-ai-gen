<template>
  <bp-navigation-bar-title>
    <PCSideBar>
      <view class="container">
        <!-- 顶部导航和搜索栏 -->
        <view class="header">
          <IconFont name="arrowleft" :size="16" color="#ffffff" @click="() => goBack()" :btnSize="30"></IconFont>
          <text class="title">{{ $i18n_t("stars.title") }}</text>
          <view @click="goToSearch">
            <IconFont name="search" :size="16" style="margin-right: 16px" color="rgba(255,255,255,1)" />
          </view>
        </view>

        <!-- 新增的水平滚动分类栏 -->
        <FrTabs :tabs="categoryTabs" :activeTabKey="currentCategoryTab" @switch="changeCategory" />

        <!-- 用户列表 -->
        <swiper class="swiper" :current="currentCategory" @change="onSwiperChange">
          <swiper-item v-for="(category, index) in categories" :key="index">
            <scroll-view scroll-y class="user-list-scroll">
              <view v-for="(user, userIndex) in category.users" :key="userIndex" class="list-item">
                <!-- 头像及徽章 -->
                <view class="avatar-container" @click="goToProfile(user.id)">
                  <FrAvatar :size="48" :url="user.avatar" />
                  <!-- <image v-if="user.isVerified" class="badge" src="/static/icons/v_small@2x.png"></image> -->
                </view>
                <view class="user-info" @click="goToProfile(user.id)">
                  <text class="user-name">{{ user.nickname }}</text>
                  <text class="user-followers">{{ $i18n_t("common.followers") + ": " + user.followersCount }}</text>
                </view>
                <view :class="['follow-button', user.isFollowing ? 'following' : '']" @click="toggleFollow(user)">
                  <text class="button-text">{{ user.isFollowing ? $i18n_t("stars.following") : $i18n_t("common.follow") }}</text>
                </view>
              </view>
            </scroll-view>
          </swiper-item>
        </swiper>
      </view>
    </PCSideBar>
  </bp-navigation-bar-title>
</template>

<script setup lang="uts">
import { FrAvatar, FrTabs } from "@/components/widgets";
import { ref, onMounted, computed } from "vue";
import IconFont from "../components/IconFont/IconFont.uvue";
import { appStore, setStarsData } from "@/store/index.uts"; // 导入 appStore 和 setStarsData
import { getStars } from "@/api/home.uts"; // 导入 getStars API
import type { CategoryListWithChildren, UserItem } from "@/types/index.uts"; // 导入 CategoryListWithChildren
import { goBack } from "../utils/page.uts";
import { $i18n_t } from "@/locale/index.uts";
import i18n from "@/locale/index.uts";
import BpNavigationBarTitle from "@/components/panels/bp-navigation-bar-title.uvue";
import PCSideBar from "@/components/PCSideBar/index.uvue";

const searchText = ref("");
const currentCategory = ref<number>(0);
const currentCategoryTab = computed<string>(() => {
  return "tab-" + currentCategory.value.toString();
});
const categories = ref<CategoryListWithChildren[]>([]);

const categoryTabs = computed(() => {
  return categories.value.map((category, index) => {
    return {
      key: "tab-" + index,
      title: category.hashtag.displayName[i18n.global.locale.value],
    };
  });
});

const clearSearch = () => {
  searchText.value = "";
};

const goToSearch = () => {
  uni.navigateTo({ url: "/pages/search" });
};

async function loadCategoriesData() {
  if (appStore.value.starsData != null) {
    // 从 store 中读取数据
    categories.value = appStore.value.starsData;
    // console.log("Stars data loaded from store.");
  } else {
    // 从 API 获取数据并存入 store
    const res = await getStars();
    if (res != null && res.success) {
      setStarsData(res.data); // 存储到 store
      categories.value = res.data;
      // console.log("Stars data loaded from API and saved to store.");
    } else {
      console.error("Failed to load stars data:", res?.error?.message);
      // Fallback to mock data if API fails
      // 这里不再需要 loadMockCategoriesData，因为 CategoryListWithChildren 结构与 mock 数据不兼容
      // 如果需要 mock 数据，需要重新定义 mock 数据的结构以匹配 CategoryListWithChildren
    }
  }
}

onMounted(() => {
  loadCategoriesData();
});

function changeCategory(key: string) {
  currentCategory.value = parseInt(key.split("-")[1]);
}

function onSwiperChange(e: UniSwiperChangeEvent) {
  currentCategory.value = e.detail.current;
}

import { followUser, unfollowUser } from "@/api/social.uts"; // 导入关注/取消关注API

// ... (其他代码不变)

function toggleFollow(user: UserItem) {
  if (user != null) {
    if (user.isFollowing) {
      // Unfollow
      unfollowUser(user.id).then((res) => {
        if (res != null && res.success) {
          user.isFollowing = false;
          user.followersCount -= 1;
          // console.log(`User ${user.nickname} unfollowed`);
        } else {
          console.error(`Failed to unfollow user ${user.nickname}:`, res?.error?.message);
        }
      });
    } else {
      // Follow
      followUser(user.id).then((res) => {
        if (res != null && res.success) {
          user.isFollowing = true;
          user.followersCount += 1;
          // console.log(`User ${user.nickname} followed`);
        } else {
          console.error(`Failed to follow user ${user.nickname}:`, res?.error?.message);
        }
      });
    }
  }
}

function goToProfile(userId: string) {
  uni.navigateTo({
    url: `/pages/profile/personal?userId=${userId}`,
  });
}
</script>

<style scoped>
