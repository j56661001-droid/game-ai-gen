  align-items: center;
  padding: 8px 16px;
}

/* 头像容器 */
.avatar-container {
  position: relative;
  width: 48px;
  height: 54px;
  border-radius: 24px;
  margin-right: 8px;
}

/* 'V' 认证徽章 */
.badge {
  position: absolute;
  bottom: 0px;
  left: 50%;
  transform: translateX(-50%);
  width: 12px;
  height: 12px;
}

/* 用户信息区域 */
.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.user-name {
  font-size: 16px;
  font-weight: 400;
  color: #ffffff;
}

.user-followers {
  font-size: 13px;
  color: #8e8e93;
  margin-top: 3px;
}

/* 关注按钮样式 */
.follow-button {
  background-color: #ff23b8;
  border-radius: 15px;
  padding: 5px 15px;
  margin-left: 10px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.follow-button.following {
  background-color: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.button-text {
  color: #ffffff;
  font-size: 14px;
  font-weight: bold;
}
</style>
