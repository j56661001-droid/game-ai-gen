  display: flex;
  flex-direction: column;
  height: 100%;
  background-color: #000000;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif;
}

/* 顶部区域 */
.header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 20px;
  min-height: 58px;
  padding: 12px 16px;
}

.title {
  color: #fff;
  font-size: 18px;
  font-weight: bold;
}

.search-icon {
  font-size: 16px;
  color: #8e8e93;
  margin-right: 8px;
}

.clear-icon {
  font-size: 12px;
  color: #8e8e93;
  width: 18px;
  height: 18px;
  display: flex;
  justify-content: center;
  align-items: center;
  font-weight: bold;
}

/* 筛选器 */
.filter {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: 10px;
}

.filter-text {
  font-size: 14px;
  margin-right: 2px;
  color: #ff23b8;
}

.filter-arrow {
  font-size: 14px;
  transform: scaleY(0.6); /* 使V形箭头更扁平 */
  color: #ff23b8;
}

/* 新增的分类标签样式 */
.categories-tabs {
  display: flex;
  flex-direction: row;
  padding: 10px 15px;
  align-items: flex-end;
  width: 100%;
}

.category-item-wrapper {
  flex-direction: row;
  align-items: center;
  position: relative;
  height: 26px;
  justify-content: flex-end;
  padding: 0 16px;
  min-width: 64px;
}

.category-item-text {
  color: rgba(255, 255, 255, 0.6);
  font-size: 14px;
  margin-bottom: 8px;
}

.category-item-text.active {
  color: #ffffff;
  font-weight: bold;
}

.active-category-indicator {
  width: 36px;
  height: 8px;
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}

/* swiper 样式 */
.swiper {
  flex: 1;
}

/* 用户列表滚动区域 */
.user-list-scroll {
  height: 100%; /* 确保swiper-item内的scroll-view有高度 */
  padding: 0 15px;
}

/* 列表项 */
.list-item {
  display: flex;
