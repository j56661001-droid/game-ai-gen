<template>
  <fr-drawer :show="show" @close="handleClose" maskClosable>
    <view class="drawer-container">
      <!-- 从设备上传 -->
      <view class="upload-container" :class="{ 'upload-container-disabled': srcPath && selectedResourceId, 'upload-container-empty': !srcPath }" @click="useUploadImage">
        <template v-if="srcPath">
          <fr-image v-if="props.resourceType === 'image'" class="uploaded-image-item" mode="aspectFit" :src="perfShowImagePath(srcPath)" />
          <fr-video
            v-else-if="props.resourceType === 'video'"
            class="uploaded-image-item"
            mode="aspectFit"
            :src="perfShowImagePath(srcPath)"
            :controls="false"
            showCenterPlayBtn
          />
          <!-- 删除 -->
          <IconFont class="uploaded-image-remove-btn" name="del" :size="12" :btnSize="24" showBg :opacity="0.6" @click="onRemoveImage"></IconFont>

          <!-- 勾选图标 -->
          <view v-if="srcPath && !selectedResourceId" class="uploaded-image-selected">
            <image src="/static/icons/selected.png" style="width: 16px; height: 16px" />
          </view>
        </template>

        <view v-else class="upload-tip-container">
          <text class="upload-tip-text">{{ $i18n_t("publish.uploadFromDevice") }}</text>
          <text v-if="props.resourceType === 'image'" class="upload-tip-description">{{
            $i18n_t("publish.supportedImageFormats", { formats: supportedImageFormats.join("、"), size: fileMaxSize.toString() })
          }}</text>
          <text v-else-if="props.resourceType === 'video'" class="upload-tip-description">{{
            $i18n_t("publish.supportedVideoFormats", { formats: supportedVideoFormats.join("、"), size: fileMaxSize.toString() })
          }}</text>
          <button class="upload-tip-button" @click.stop="onImagePicker">{{ $i18n_t("publish.browseFiles") }}</button>
        </view>
      </view>

      <!-- 官方推荐 / 我的上传 -->
      <view v-if="resLoading" class="tabs-loading">
        <fr-spin />
        <text class="tabs-loading-text">{{ $i18n_t("common.loading_") }}</text>
      </view>
      <view class="tabs-container" v-else>
        <fr-tabs :tabs="tabs" :active-tab-key="activeTabKey" @switch="onTabSwitch" class="fr-tabs">
          <template #default="{ tab, selected }">
            <view class="tabs-item-container">
              <text class="fr-tabs-item-title" :class="{ 'tabs-active': selected }">{{ tab.title }}</text>
              <!-- 下划线 -->
              <view class="tabs-underline" :class="{ 'tabs-active-underline': selected }" />
            </view>
          </template>
        </fr-tabs>

        <swiper class="tabs-swiper" :current-item-id="activeTabKey" @change="onSwiperChange">
          <swiper-item v-for="tab in tabs" :key="tab.key" :item-id="tab.key">
            <view v-if="activeCacheState[tab.key]" class="tab-content-wrapper">
              <view v-if="tab.key === TAB_KEY.OFFICIAL" class="tab-content">
                <resources-list
                  :list="officialResourcesList"
                  :selectedId="selectedResourceId"
                  :loading="officialLoading"
                  :pagination="officialPagination"
                  :resourceType="props.resourceType"
                  @searchKeyword="handleOfficialSearchKeyword"
                  :hintText="$i18n_t('publish.officialResourcesHint')"
                  :emptyText="$i18n_t('publish.noOfficialResources')"
                  @select="handleResourceSelect"
                  @loadMore="handleLoadMoreOfficialResources"
                  showSearch
                />
              </view>

              <view v-else-if="tab.key === TAB_KEY.MY_UPLOAD" class="tab-content">
                <resources-list
                  :list="myUploadResourcesList"
                  :selectedId="selectedResourceId"
                  :loading="myUploadLoading"
                  :pagination="myUploadPagination"
                  :resourceType="props.resourceType"
                  @searchKeyword="handleMyUploadSearchKeyword"
                  :hintText="$i18n_t('publish.myUploadsHint')"
                  :emptyText="$i18n_t('publish.noUploadRecords')"
                  @select="handleResourceSelect"
                  @loadMore="loadMoreMyUploadResources"
                />
              </view>
            </view>
          </swiper-item>
        </swiper>
      </view>
    </view>

    <!-- 确认选择 -->
    <button class="confirm-btn" 
      :disabled="!selectedResourceId && !srcPath" 
      :class="{ 'confirm-btn-disabled': !selectedResourceId && !srcPath }" 
      @click="onConfirm"
    >
      {{ $i18n_t("publish.confirmSelection") }}
    </button>
  </fr-drawer>
</template>

<script setup lang="uts">
import { ref, reactive, watch, computed } from "vue";
import FrDrawer from "@/components/widgets/fr-drawer.uvue";
import FrSpin from "@/components/widgets/fr-spin.uvue";
import IconFont from "@/components/IconFont/IconFont.uvue";
import FrImage from "@/components/widgets/fr-image.uvue";
import FrVideo from "@/components/widgets/fr-video.uvue";
import FrTabs from "@/components/widgets/fr-tabs.uvue";
import { $i18n_t, getLocale } from "@/locale/index.uts";
import { nativeUpload, getAbsoluteMediaUrl } from "@/api/request.uts";
import { Tab } from "@/components/widgets/type.uts";
import ResourcesList from "./resources-list.uvue";
import { getOfficialLibrary } from "@/api/file.uts";
import { getUserLibrary } from "@/api/user.uts";
import { user } from "@/store/user";

enum TAB_KEY {
  OFFICIAL = "official",
  MY_UPLOAD = "myUpload",
}

type Props = {
  show: boolean;
  maskClosable?: boolean;
  resourceType?: "image" | "video" | null; // 资源类型过滤：image-仅图片，video-仅视频，all-全部
};

const supportedImageFormats = ["JPG", "PNG"];
const supportedVideoFormats = ["MP4", "MOV", "AVI"];
const props = withDefaults(defineProps<Props>(), {
  show: false,
  resourceType: "image",
});

const emit = defineEmits<{
  (e: "close"): void;
  (e: "change", images: string): void;
}>();

const tabsData = ref<Tab[]>([
  { title: $i18n_t("publish.officialRecommended"), key: TAB_KEY.OFFICIAL, icon: null, hidden: true },
  { title: $i18n_t("publish.myUploads"), key: TAB_KEY.MY_UPLOAD, icon: null, hidden: false },
]);

// Tabs 相关
const tabs = computed((): Tab[] => tabsData.value.filter((tab) => !tab?.hidden));

// 获取工具id
const toolId = ref<string>("");
const activeTabKey = ref<string>(TAB_KEY.OFFICIAL);
// 缓存已激活的标签页内容
const activeCacheState = reactive<UTSJSONObject>({});
const fileMaxSize = 100;

/**
 * 辅助方法：更新tabsData
 */
const updateTabsData = (key: string, data: Partial<Tab>) => {
  const index = tabsData.value.findIndex((tab) => tab.key === key);
  if (index !== -1) {
    tabsData.value[index] = {...tabsData.value[index], ...data};
  }
};

onLoad((options) => {
  if (options != null && options["id"] != null) {
    toolId.value = options["id"] as string;
  }
});

// 监听标签切换，缓存已激活的标签页
watch(
  () => activeTabKey.value,
  (key: string) => {
    activeCacheState[key] = true;
  },
  { immediate: true },
);

const handleClose = () => {
  if (isResLoadState) {activeTabKey.value = TAB_KEY.OFFICIAL;}
  resLoading.value = isResLoadState;
  emit("close");
};

// const handleOverlayClick = (event: UniPointerEvent) => {
//   // 只有点击蒙版区域且允许蒙版关闭时才响应关闭事件
//   if (props.maskClosable && event.target == event.currentTarget) {
//     emit("close");
//   }
// };
// 点击标签切换
const onTabSwitch = (key: string) => {
  activeTabKey.value = key;
};

// 滑动切换
const onSwiperChange = (e: UniSwiperChangeEvent) => {
  const key = e.detail?.currentItemId as string;
  if (key != null) {
    activeTabKey.value = key;
  }
};

// 图片上传相关
const srcPath = ref<string>("");
const localSourceCache = reactive<UTSJSONObject>({});
const uploadLock = ref<boolean>(false);

// 资源列表相关
type ResourceItem = {
  id: string;
  contentType: string;
  fileURL: string;
  cover?: string;
  tag?: string;
  description?: string;
  // encryptionKey?: string;
};

// 选中的资源ID
const selectedResourceId = ref<string | null>(null);

// 官方推荐列表
const officialResourcesList = ref<ResourceItem[]>([]);
const officialLoading = ref<boolean>(false);
const officialPagination = ref<UTSJSONObject | null>(null);
const officialPageSize = 20;

// 我的上传列表
const myUploadResourcesList = ref<ResourceItem[]>([]);
const myUploadLoading = ref<boolean>(false);
const myUploadPagination = ref<UTSJSONObject | null>(null);
const myUploadPageSize = 10;

const isResLoadState = true  // 使用资源加载状态，true的时候每次打开页面都加载资源（空官方推荐隐藏）。false的时候只加载一次（空官方推荐不隐藏）
const resLoading = ref<boolean>(isResLoadState);

// 性能优化：优先显示本地图片路径
const perfShowImagePath = (path: string): string => {
  return localSourceCache[path] != null ? (localSourceCache[path] as string) : path;
};

// 删除图片
const onRemoveImage = () => {
  console.log("onRemoveImage");
  srcPath.value = "";
  // emit("change", srcPath.value);
};

// 上传文件（图片/视频）
const uploadFile = async (file: any) => {
  if (uploadLock.value) {
    return;
  }

  uni.showLoading({
    title: $i18n_t("common.uploading"),
    mask: true,
  });

  try {
    let nativeFile: File;
    let localPath: string;

    // 根据资源类型确定文件配置
    const isVideo = props.resourceType === "video";
    const defaultFileName = isVideo ? "video.mp4" : "image.jpg";
    const defaultFileType = isVideo ? "video/mp4" : "image/jpeg";
    const category = isVideo ? "video" : "image";

    // 检查是否是原生 File 对象还是临时文件路径对象
    if (file instanceof File) {
      // 直接是 File 对象
      nativeFile = file;
      localPath = URL.createObjectURL(file); // 创建本地预览URL
    } else if (file.path) {
      // 临时文件路径，需要转换
      const response = await fetch(file.path);
      const blob = await response.blob();
      nativeFile = new File([blob], file.name || defaultFileName, { type: defaultFileType });
      localPath = file.path;
    } else {
      throw new Error("Invalid file object");
    }

    await nativeUpload(
      {
        url: `files/upload`,
        file: nativeFile,
        data: {
          category: category,
        },
      },
      true,
    ).then(({ data }) => {
      if (data == null) {
        return;
      }
      const fileURL: string = data.fileURL as string;

      // 缓存本地路径用于预览
      localSourceCache[fileURL] = localPath;

      // 更新文件路径
      srcPath.value = fileURL;
      useUploadImage();

    });
  } catch (error) {
    console.error("Upload failed:", error);
    uni.showToast({
      title: $i18n_t("s_msg.uploadFailed") || "上传失败",
      icon: "none",
    });
  } finally {
    uni.hideLoading();
  }
};

/** 
 * 选择上传的照片
 */
const useUploadImage = () => {
  if (!srcPath.value) return;
  selectedResourceId.value = null;
};

/**
 * 选择照片或视频
 */
const onImagePicker = () => {
  if (props.resourceType === "image") {
    uni.chooseImage({
      count: 1,
      success(res) {
        const file = res.tempFiles?.[0] || res.tempFile;
        if (file != null) {
          uploadFile(file);
        }
      },
      fail(err) {
        console.error("Choose image failed:", err);
      },
    });
  } else if (props.resourceType === "video") {
    uni.chooseVideo({
      count: 1,
      success(res) {
        const file = res.tempFiles?.[0] || res.tempFile;
        if (file != null) {
          uploadFile(file);
        }
      },
      fail(err) {
        console.error("Choose video failed:", err);
      },
    });
  }
};

/**
 * 处理资源选择
 */
const handleResourceSelect = (id: string | null) => {
  selectedResourceId.value = id;
};

/**
 * 处理加载更多事件
 */
const handleLoadMoreOfficialResources = () => {
  const currentPage = (officialPagination.value?.page as number) || 1;
  const hasNext = (officialPagination.value?.has_next as boolean) || false;

  if (officialLoading.value || !hasNext) {
    return;
  }
  getOfficialResources(currentPage + 1);
};

/**
 * 处理官方推荐搜索关键词
 */
const handleOfficialSearchKeyword = (keyword: string) => {
  getOfficialResources(1, keyword);
};

/**
 * 处理我的上传搜索关键词
 */
const handleMyUploadSearchKeyword = (keyword: string) => {
  getUserResources(1, keyword);
};

/**
 * 处理我的上传加载更多
 */
const loadMoreMyUploadResources = () => {
  const currentPage = (myUploadPagination.value?.page as number) || 1;
  const hasNext = (myUploadPagination.value?.has_next as boolean) || false;

  if (myUploadLoading.value || !hasNext) {
    return;
  }
  getUserResources(currentPage + 1);
};

/**
 * 获取官方推荐资源
 */
const getOfficialResources = async (page: number = 1, keyword: string = "") => {
  if (officialLoading.value) return;

  // 清空列表，展示loading
  if (page === 1) officialResourcesList.value = [];
  officialLoading.value = true;
  try {
    const res = await getOfficialLibrary({ id: toolId.value, page, size: officialPageSize, keyword: keyword, mime: props.resourceType });
    if (res == null || !res.success) {
      console.error("Get official resources failed:", res.error?.message);
      // 显示错误信息
      uni.showToast({
        title: res.error?.message,
        icon: "none",
      });
      return;
    }

    // 空数据，隐藏官方推荐标签（并且不是搜索后为空）
    if ((res.data == null || res.data.length === 0) && !keyword) {
      updateTabsData(TAB_KEY.OFFICIAL, { hidden: true });
      activeTabKey.value = TAB_KEY.MY_UPLOAD;
      return;
    }
    updateTabsData(TAB_KEY.OFFICIAL, { hidden: false });

    // 获取当前语言
    const currentLocale = getLocale() || "zh_hans";
    const data = res.data.map((i: OfficialLibraryResponse, index: number) => ({
      id: index.toString(),
      fileURL: i.url,
      cover: i.url,
      contentType: i.mime.includes("image") ? "image" : "video",
      description: i.title[currentLocale] || "",
      tag: $i18n_t("publish.official"),
    }));

    officialResourcesList.value = [...officialResourcesList.value, ...data];
    officialPagination.value = res.meta?.pagination || null; // 保存接口返回的完整分页信息
  } catch (err) {
    console.error("Load official resources failed:", err);
  } finally {
    officialLoading.value = false;
    resLoading.value = false;
  }
};

/**
 * 获取我的上传资源
 */
const getUserResources = async (page: number = 1, keyword: string = "") => {
  if (myUploadLoading.value) {
    return;
  }
  // 清空列表，展示loading
  if (page === 1) myUploadResourcesList.value = [];
  myUploadLoading.value = true;
  try {
    const res = await getUserLibrary({ id: user.value?.id, page, size: myUploadPageSize, name: keyword, category: props.resourceType });
    if (res == null || !res.success) {
      console.error("Get user resources failed:", res.error?.message);
      // 显示错误信息
      uni.showToast({
        title: res.error?.message,
        icon: "none",
      });
      return;
    }
    if (res.data == null) return;

    const data = res.data.map((i) => ({
      id: i.id,
      fileURL: getAbsoluteMediaUrl(i.fileURL),
      // cover: getAbsoluteMediaUrl(i.cover || i.fileURL),
      contentType: i.mimeType.includes("image") ? "image" : "video",
    }));
    myUploadResourcesList.value = [...myUploadResourcesList.value, ...data];
    myUploadPagination.value = res.meta?.pagination || null; // 保存接口返回的完整分页信息
  } catch (err) {
    console.error("Get user resources failed:", err);
  } finally {
    myUploadLoading.value = false;
  }
};

// 监听标签页切换，首次加载数据
watch(
  () => ({ key: activeTabKey.value, show: props.show, resourceType: props.resourceType }),
  ({ key, show, resourceType }, oldValue) => {
    if (!show) return;
    // 如果资源类型发生变化，清空列表并重置分页信息。避免切换时数据不正确
    if (resourceType !== oldValue?.resourceType) {
      officialResourcesList.value = [];
      myUploadResourcesList.value = [];
      officialPagination.value = null;
      myUploadPagination.value = null;
    }
    if (key === TAB_KEY.OFFICIAL) {
      getOfficialResources(1);
    } else if (key === TAB_KEY.MY_UPLOAD) {
      getUserResources(1); // 默认最多只加载10条
    }
  },
  { immediate: true },
);

/**
 * 确认选择
 */
const onConfirm = () => {
  // 如果选中了资源，使用选中的资源；否则使用上传的图片
  if (selectedResourceId.value != null) {
    // 查找选中的资源
    let selectedResource: ResourceItem | null = null;
    if (activeTabKey.value === TAB_KEY.OFFICIAL) {
      selectedResource = officialResourcesList.value.find((item) => item.id === selectedResourceId.value) || null;
    } else {
      selectedResource = myUploadResourcesList.value.find((item) => item.id === selectedResourceId.value) || null;
    }

    if (selectedResource != null) {
      emit("change", selectedResource.fileURL);
    }
  } else if (srcPath.value !== "") {
    // 上传的资源
    emit("change", srcPath.value);
  }

  handleClose();
  // 重置状态
  srcPath.value = "";
  selectedResourceId.value = null;
};
</script>

<style scoped>
.drawer-container {
  position: relative;

  height: 100%;
  /* color: #fff; */
  /* padding: 0 24px; */
  /* flex-direction: column; */
  display: flex;
}

/* 资源上传容器 */
.upload-container {
  margin: 0 24px;
  height: 130px;
  border-radius: 12px;
  border: 1px solid rgba(255, 35, 184, 1);
  display: flex;
  align-items: center;
}

.upload-container-empty {
  border: 1px dashed rgba(255, 35, 184, 1);
  background-color: rgba(255, 35, 184, 0.2);
}

.upload-container-disabled {
  border-color:rgb(79, 79, 79);
}

.upload-tip-container {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.upload-tip-text {
  color: #fff;
  font-size: 14px;
  font-weight: Semibold;
  margin: 4px 0;
}
.upload-tip-description {
  color: rgba(255, 255, 255, 0.4);
  font-size: 12px;
  font-weight: 400;
}

.upload-tip-button {
  /* width: 108px; */
  height: 40px;
  border-radius: 20px;
  background-color: rgba(255, 35, 184, 1);
  margin-top: 12px;
  color: #fff;
  font-size: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.uploaded-image-item {
  width: 100%;
  height: 100%;
  border-radius: 4px;
}

.uploaded-image-selected {
  position: absolute;
  top: 9px;
  left: 9px;
  z-index: 10;
}

.uploaded-image-remove-btn {
  position: absolute;
  top: 5px;
  right: 5px;
  z-index: 10;
}

.tabs-loading {
  width: 100%;
  margin-top: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tabs-loading-text {
  font-size: 14px;
  margin-left: 10px;
  color: #ccc;
  margin-top: 10px;
}

/* Tabs 容器 */
.tabs-container {
  margin-top: 30px;
  width: 100%;
  flex: 1;
  flex-direction: column;
}

.fr-tabs {
  margin-left: 8px;
  margin-bottom: 0;
}

.fr-tabs-item-title {
  color: #fff;
  font-size: 14px;
  font-weight: Semibold;
}
.tabs-underline {
  width: 100%;
  height: 2px;
  margin-top: 7px;
}
.tabs-active-underline {
  background-color: rgba(255, 35, 184, 1);
}
.tabs-active {
  color: rgba(255, 35, 184, 1);
}

.tabs-swiper {
  flex: 1;
  width: 100%;
  /* margin: 0 24px; */
}

.tab-content-wrapper {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.tab-content {
  flex: 1;
  width: 100%;
  height: 100%;
  /* padding: 0 24px; */
}

.confirm-btn {
  position: absolute;
  bottom: 16px;
  left: 24px;
  right: 24px;
  height: 40px;
  border-radius: 20px;
  background: linear-gradient(134deg, #ff00d8 0%, #fff500 100%);
  margin-top: 12px;
  color: #fff;
  font-weight: Semibold;
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.confirm-btn-disabled[disabled] {
  background: #5A5A5A;
  color: rgba(150, 150, 150, 1);
}

.tabs-item-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
</style>
