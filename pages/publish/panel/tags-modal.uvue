<template>
  <view class="tags-modal">
    <scroll-view class="tags-modal-scroll" direction="vertical">
      <view class="tags-modal-content">
        <view class="tags-header">
          <text class="tags-title">{{ $i18n_t("publish.publish_new") }}</text>
          <view class="close-button-wrapper" @click="() => emit('close')">
            <icon-font name="close" :size="8" color="#ddd" />
          </view>
        </view>
        <text class="tags-share">{{ $i18n_t("publish.share_idea") }}</text>
        <view class="tags-share-wrapper">
          <textarea
            class="tags-share-input"
            placeholder-class="tags-share-input-placeholder"
            :placeholder="$i18n_t('publish.please_enter')"
            v-model="publishDescription"
          />
          <view class="tags-share-tag">
            <text class="tags-share-tag-item" v-for="tag in renderSelectedTagList">#{{ tag }}</text>
          </view>
        </view>
        <view class="tags-add-wrapper">
          <text class="tags-add-title">{{ $i18n_t("publish.add_tags") }}</text>
          <text class="tags-add-subtitle" v-if="selectedTagList.length">{{ $i18n_t("publish.had_add_tags", { num: selectedTagList.length }) }}</text>
          <text class="tags-add-subtitle" v-else>{{ $i18n_t("publish.can_add_tags") }}</text>
        </view>
        <text class="tags-recommended">{{ $i18n_t("publish.recommended_tags") }}</text>
        <view class="tags-recommended-list">
          <text
            :class="['tags-recommended-item', { active: selectedTagList.includes(tag.id) }]"
            v-for="tag in recommendedTagList"
            @click="() => handleTagItemClick(tag)"
          >
            {{ tag.displayName[i18n.global.locale.value] }}
          </text>
        </view>
        <text class="tags-custom">{{ $i18n_t("publish.custom_tags") }}</text>
        <view class="tags-custom-list">
          <text class="tags-custom-base" @click="createCustomTag" v-if="customTagList.length < 10">
            + {{ $i18n_t("publish.custom_tags") }}
            <FrSpin class="tags-custom-base-loading" type="primary" v-if="addTagLoading" />
          </text>
          <view :class="['tags-custom-item', { active: selectedTagList.includes(tag.id) }]" v-for="tag in customTagList" @click="() => handleTagItemClick(tag)">
            {{ tag.displayName[i18n.global.locale.value] || tag.name }}
            <FrSpin class="tags-custom-close-loading" type="primary" v-if="tag.isLoading" />
            <view class="tags-custom-close" @click="deleteCustomTag($event, tag)" v-else>
              <icon-font name="close" :size="6" color="#ddd" />
            </view>
          </view>
        </view>
        <view class="tags-btn-wrapper">
          <text class="tags-btn-cancel" @click="() => emit('close')">{{ $i18n_t("common.cancel") }}</text>
          <fr-button class="tags-btn-publish" :loading="isPublishing" @click="() => handlePublish()">{{ $i18n_t("publish.publish_now") }}</fr-button>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted } from "vue";
import { user } from "@/store/user.uts";
import { FrButton, FrSpin } from "@/components/widgets";
import i18n, { $i18n_t } from "@/locale";
import IconFont from "@/components/IconFont/IconFont.uvue";
import { getTagsList, addTag, removeTag } from "@/api/home.uts";
import { TagItemData } from "@/types";

const props = defineProps<{
  toolID: string;
  isPublishing: boolean;
}>();

const emit = defineEmits<{
  (e: "close"): void;
  (
    e: "onConfirmPublish",
    params: {
      selectedTagList: string[];
      description: string;
    },
  ): void;
}>();

const recommendedTagList = ref<TagItemData[]>([]); // 推荐标签
const customTagList = ref<TagItemData[]>([]); // 自定义标签
const selectedTagList = ref<string[]>([]); // 已选标签
const publishDescription = ref("");
const addTagLoading = ref(false);

const renderSelectedTagList = computed(() => {
  return selectedTagList.value.map((item) => {
    const tag = customTagList.value.find((tag) => tag.id === item) || recommendedTagList.value.find((tag) => tag.id === item);
    return tag.displayName[i18n.global.locale.value] || tag.name;
  });
});

const handleTagItemClick = (tag) => {
  // 如果已选中，则移除
  if (selectedTagList.value.includes(tag.id)) {
    selectedTagList.value = selectedTagList.value.filter((item) => item !== tag.id);
    return
  }
  // 最多只能选择8个
  if (selectedTagList.value.length >= 8) {
    return uni.showToast({
      title: $i18n_t("publish.tag_limit"),
      icon: "error",
    });
  }
  // 添加标签
  selectedTagList.value.push(tag.id);
};
const deleteCustomTag = async (event, tag) => {
  // 阻止事件冒泡
  event.stopPropagation();
  event.preventDefault();
  try {
    tag.isLoading = true;
    await removeTag(user.value?.id, [tag.id]);
    tag.isLoading = false;
    selectedTagList.value = selectedTagList.value.filter((item) => item !== tag.id);
    customTagList.value = customTagList.value.filter((item) => item.id !== tag.id);
  } catch (error) {
    tag.isLoading = false;
    console.error("Failed to delete tag:", error);
  }
};
const createCustomTag = () => {
  if (addTagLoading.value) return;
  uni.showModal({
    title: `+ ${$i18n_t("publish.custom_tags")}`,
    confirmText: $i18n_t("common.confirm"),
    cancelText: $i18n_t("common.cancel"),
    editable: true,
    placeholderText: $i18n_t("publish.please_enter"),
    success: async (res) => {
      if (res.confirm) {
        if (!res.content) {
          return uni.showToast({
            title: $i18n_t("publish.tag_empty"),
            icon: "error",
          });
        }
        if (customTagList.value.includes(res.content)) {
          return uni.showToast({
            title: $i18n_t("publish.tag_exists"),
            icon: "error",
          });
        }
        if (res.content.length > 10) {
          return uni.showToast({
            title: $i18n_t("publish.tag_too_long"),
            icon: "error",
          });
        }
        try {
          addTagLoading.value = true;
          const addRes = await addTag(user.value?.id, res.content);
          addTagLoading.value = false;
          customTagList.value.push(addRes.data);
          // 不超过8个就自动选中
          if (selectedTagList.value.length < 8) {
            selectedTagList.value.push(addRes.data.id);
          }
          uni.showToast({
            title: $i18n_t("publish.create_success"),
            icon: "none",
          });
        } catch (error) {
          addTagLoading.value = false;
          console.error("Failed to add tag:", error);
        }
      }
    },
  });
};
const handlePublish = () => {
  const publishData = {
    description: publishDescription.value,
    selectedTagList: selectedTagList.value,
  };
  emit("onConfirmPublish", publishData);
};
const initializeData = async () => {
  try {
    const res = await getTagsList(user.value?.id, props.toolID);
    const arr = res.data || [];
    recommendedTagList.value = arr.filter((item) => item.scope === "tool");
    customTagList.value = arr.filter((item) => item.scope === "user");
  } catch (error) {
    console.error("Failed to load data:", error);
  }
};
onMounted(() => {
  initializeData();
});
</script>

