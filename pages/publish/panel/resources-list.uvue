<template>
  <view class="container">
    <!-- 搜索框 -->
    <view class="search-container">
      <view v-if="showSearch" class="search-input-container">
        <IconFont name="search" :size="14" color="rgba(255, 255, 255, 0.5)" />
        <input type="text" class="search-input" :placeholder="$i18n_t('publish.searchAssets')" :value="searchKeyword" @input="handleSearchInput" />
      </view>
      <text class="search-input-hint">{{ props.hintText }}</text>
    </view>

    <!-- 列表 -->
    <fr-adaptive-list
      class="resource-list"
      :min-column="2"
      :min-width="230"
      :loading="props.loading"
      :data-source="list"
      :pagination="props.pagination"
      :empty-text="emptyText"
      paddingBottom="100px"
      @loadmore="handleLoadMore"
    >
      <template #record="{ record }">
        <view class="list-item" :class="{ 'list-item-active': record.id === props.selectedId }">
          <view class="item-image-container">
            <bp-image-display
              v-if="record.contentType === 'image'"
              class="item-image"
              :src="record.fileURL"
              :cover="record.cover"
              :autoresize="false"
              mode="aspectFill"
              :showCenterPlayBtn="true"
              @click="handleItemClick(record as ResourceItem)"
              list-play
            ></bp-image-display>
            <bp-video-display
              v-else-if="record.contentType === 'video'"
              class="item-image"
              :src="record.fileURL"
              :cover="record.cover"
              :autoresize="false"
              imageMode="aspectFill"
              object-fit="cover"
              :showCenterPlayBtn="true"
              @click="handleItemClick(record as ResourceItem)"
              @click:play="handlePlayClick(record as ResourceItem)"
              list-play
            ></bp-video-display>
            
            <!-- 视频播放按钮 -->
            <!-- <view v-if="record.contentType === 'video'" class="video-play-button" @click.stop="handlePlayClick(record as ResourceItem)">
              <IconFont name="play" :size="18" color="#FFFFFF" />
            </view> -->
          </view>

          <!-- 标签 - 可选 -->
          <view v-if="record.tag != null && record.tag !== ''" class="item-tag">
            {{ record.tag }}
          </view>

          <!-- 勾选图标 -->
          <view v-if="record.id === props.selectedId" class="item-selected">
            <image src="/static/icons/selected.png" style="width: 16px; height: 16px" />
          </view>

          <!-- 描述 - 可选 -->
          <view v-if="record.description != null && record.description !== ''" class="item-description">
            <view class="item-description-box">
              <!-- #ifdef APP -->
              <text class="item-description-text" :lines="1">{{ record.description }}</text>
              <!-- #endif -->
              <!-- #ifndef APP -->
              <text class="item-description-text">{{ record.description }}</text>
              <!-- #endif -->
            </view>
          </view>
        </view>
      </template>
    </fr-adaptive-list>

  </view>
</template>

<script setup lang="uts">
import { ref, computed, watch } from "vue";
import BpMediaDisplay from "@/components/panels/bp-media-display.uvue";
import IconFont from "@/components/IconFont/IconFont.uvue";
import { FrAdaptiveList } from "@/components/widgets";
import { $i18n_t } from "@/locale/index.uts";
import { debounce } from "@/utils/debounce.uts";
import BpVideoDisplay from "@/components/panels/bp-video-display.uvue";
import BpImageDisplay from "@/components/panels/bp-image-display.uvue";

// 定义资源项类型
type ResourceItem = {
  id: string;
  contentType: string;
  fileURL: string;
  cover?: string;
  tag?: string; // 可选标签
  description?: string; // 可选描述
  // encryptionKey?: string;
};

// Props定义
type Props = {
  list: ResourceItem[]; // 资源列表
  selectedId?: string | null; // 选中的项目ID
  loading?: boolean; // 加载状态
  pagination?: UTSJSONObject | null; // 分页信息对象
  emptyText?: string; // 空状态文本
  hintText?: string; // 提示文本
  resourceType?: 'image' | 'video' | 'all'; // 资源类型过滤：image-仅图片，video-仅视频，all-全部
  searchKeyword?: string;
  showSearch?: boolean;
};

const props = withDefaults(defineProps<Props>(), {
  list: () => [],
  selectedId: null,
  loading: false,
  pagination: null,
  emptyText: "",
  hintText: "",
  resourceType: 'all',
  searchKeyword: '',
  showSearch: false,
});

// 是否播放视频
const playVideo = ref<boolean>(false);

// Emits定义
const emit = defineEmits<{
  select: [id: string | null]; // 选中/取消选中事件
  loadMore: []; // 加载更多事件
  searchKeyword: [keyword: string]; // 搜索关键词事件
}>();

// 创建防抖搜索函数
const debouncedSearch = debounce((keyword: string) => {
  emit("searchKeyword", keyword);
}, 500);

// 处理搜索输入
function handleSearchInput(event: UniInputEvent): void {
  debouncedSearch(event.detail.value);
}

// 处理视频播放
function handlePlayClick(record: ResourceItem): void {
  playVideo.value = true;
}

// 空状态文本
const emptyText = computed((): string => {
  return props.emptyText !== "" ? props.emptyText : $i18n_t("common.noData");
});

// 处理项目点击（选中/取消选中）
function handleItemClick(item: ResourceItem | UTSJSONObject): void {
  const itemId = (item as UTSJSONObject).id as string;
  
  // 选中逻辑：如果当前项已选中，则取消选中；否则选中该项
  if (itemId === props.selectedId) {
    emit("select", null);
  } else {
    emit("select", itemId);
  }
}

// 处理加载更多
function handleLoadMore(pagination: UTSJSONObject): void {
  const hasNext = (props.pagination?.has_next as boolean) || false;
  if (!props.loading && hasNext) {
    emit("loadMore");
  }
}

// 处理视频结束
function handleVideoEnded(record: ResourceItem): void {
  playVideo.value = false;
}
</script>

<style scoped>
