<template>
  <bp-navigation-bar-title>
    <view class="page-container">
      <!-- 页面头部 -->

      <view class="header">
        <IconFont name="arrowleft" :size="16" color="#ffffff" @click="() => goBack()" :btnSize="30"></IconFont>
        <text class="header-title">{{ $i18n_t("topics.title") }}</text>
        <view @click="goToSearch()">
          <IconFont name="search" :size="18"></IconFont>
        </view>
      </view>

      <!-- 可滚动内容区域 -->
      <scroll-view class="content-scroll" scroll-y="true">
        <view class="section" v-for="(section, index) in sections" :key="`section_${index}`">
          <!-- 分区标题 -->
          <view class="section-header">
            <view class="rank-indicator" :style="{ backgroundColor: rankColors[index] }"></view>
            <text class="section-rank" :style="{ color: rankColors[index] }">{{ index + 1 }}</text>
            <text class="section-category">{{ section.hashtag.displayName[i18n.global.locale.value] }}</text>
          </view>

          <!-- 内容项行 -->
          <view class="items-row">
            <view class="item-card" v-for="(item, index) in section.posts.slice(0, 3)" :key="index" @click="goToVideo(item)">
              <view class="item-image">
                <VideoDisplay
                  v-if="item.contentType == 'video' && item.mediaMetadata[0].cover == null"
                  :autoresize="false"
                  :src="item.mediaMetadata[0].fileURL"
                />
                <bp-image-display v-else :src="getCoverUrl(item)" :encryptionKey="item.mediaMetadata[0]?.encryptionKey" :autoresize="false" mode="aspectFill"></bp-image-display>
              </view>
              <text class="item-title">{{ item.content }}</text>
              <!-- <text class="item-subtitle">{{ item.description }}</text> -->
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </bp-navigation-bar-title>
</template>

<script setup lang="ts">
import { Ref, onMounted } from "vue";
import { PostItem, CategoryItem, CategoryListWithChildren } from "@/types/index";
import { setVideoResourceList, setVideoInitialIndex } from "../store/index.uts";
import { getCoverUrl } from "../utils/coverUtils.uts";
import VideoDisplay from "@/components/panels/bp-video-display.uvue";
import BpImageDisplay from "@/components/panels/bp-image-display.uvue";
import { goBack } from "../utils/page.uts";
import { getPopularTopicsPosts } from "@/api/home.uts";
import { $i18n_t } from "@/locale/index.uts";
import i18n from "@/locale/index.uts";
import BpNavigationBarTitle from "@/components/panels/bp-navigation-bar-title.uvue";

// 定义列表分区的类型
type TopicSection = {
  rank: string;
  category: string;
  color: string;
  items: PostItem[];
};

const loading = ref(true);

const sections: Ref<CategoryListWithChildren[]> = ref<CategoryListWithChildren[]>([]);
const rankColors = ref(["#FF5A5A", "#FFB800", "#4CAF50", "#1E88E5", "#7B1FA2", "#795548"]);

onMounted(async () => {
  let res = await getPopularTopicsPosts();
  if (res != null && res.success && res.data != null) {
    sections.value = res.data;
  }
});

const goToSearch = () => {
  uni.navigateTo({ url: "/pages/search" });
};

const goToVideo = (item: PostItem) => {
  setVideoResourceList([item]);
  setVideoInitialIndex(0);
  uni.navigateTo({ url: "/pages/video?" });
};
</script>

<style>
.page-container {
  flex: 1;
  flex-direction: column;
  padding: 0;
  background-color: #000000;
}

.header {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 20px;
  min-height: 58px;
  padding: 12px 16px;
}

.header-icon {
  color: #ffffff;
  font-size: 18px;
}

.header-title {
  color: #ffffff;
  font-size: 18px;
  font-weight: bold;
}

.search-icon {
  width: 24px;
  height: 24px;
}

.content-scroll {
  flex: 1;
}

.section {
  margin: 24px 16px 0 16px;

  padding: 16px 12px;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 10px;
}

.section-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 24px;
}

.rank-indicator {
  width: 4px;
  height: 16px;
  border-radius: 2px;
  margin-right: 8px;
}

.section-rank {
  font-size: 14px;
  font-weight: bold;
}

.section-category {
  color: #ffffff;
  font-size: 14px;
  font-weight: bold;
  margin-left: 8px;
}

.items-row {
  flex-direction: row;
  justify-content: space-between;
}

.item-card {
  flex-direction: column;
  align-items: center;
  width: 30%;
}

.item-image {
  width: 110px;
  height: 110px;
  border-radius: 12px;
  background-color: #333333;
  /* 图像加载前的占位颜色 */
}

.item-title {
  color: #ffffff;
  font-size: 12px;
  margin-top: 16px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-subtitle {
  color: #aaaaaa;
  font-size: 12px;
  margin-top: 4px;
  width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
</style>
