      <view class="bg-panel-footer">
        <text class="bg-panel-footer-text">{{ loginIndicatesText }}</text>
        <view style="flex-direction: row; align-items: center">
          <text class="bg-panel-footer-light-text" @click="onGoToUserSA">{{ userServicesAgreementText }}</text>
          <text class="bg-panel-footer-text">{{ andText }}</text>
          <text class="bg-panel-footer-light-text" @click="onGotoUserPP">{{ userPrivacyPolicyText }}</text>
