</template>

<script setup lang="uts">
import { $i18n_t } from "@/locale/index.uts";

const loginIndicatesText = computed(() => $i18n_t("account.loginIndicates"));
const userServicesAgreementText = computed(() => $i18n_t("account.userServicesAgreement"));
const andText = computed(() => $i18n_t("common.and"));
const userPrivacyPolicyText = computed(() => $i18n_t("account.userPrivacyPolicy"));

const props = defineProps<{
  hideFooter?: boolean;
}>();

const onGoToUserSA = () => {
  uni.navigateTo({
    url: `/pages/profile/TermsOfService`,
  });
};

const onGotoUserPP = () => {
  uni.navigateTo({
    url: `/pages/profile/PrivacyPolicy`,
  });
};
</script>

