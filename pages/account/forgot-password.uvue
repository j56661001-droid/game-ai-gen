<template>
  <view class="container">
    <view class="close-icon">
      <icon-font name="close" :size="20" color="#fff" @click="onClose"></icon-font>
    </view>
    <view class="content">
      <text class="title">{{ i18nForgotPasswordText }}</text>

      <view class="progress-bar">
        <view class="progress-step" :class="{ active: step === 1 }"></view>
        <view class="progress-divider"></view>
        <view class="progress-step" :class="{ active: step === 2 }"></view>
      </view>

      <!-- Step 1: Enter email and verification code -->
      <view v-if="step === 1" class="form-step">
        <text class="subtitle">{{ i18nWhatsYourEmailText }}</text>
        <text-input
          :placeholder="i18nEmailText"
          style="margin-bottom: 16px; width: 100%;"
          type="email"
          :value="formState.email"
          @change="onFormChange('email', $event)"
        ></text-input>
        <view class="verification-code-container">
          <text-input
            :placeholder="i18nVerityCodeText"
            type="number"
            style="flex: 1;"
            :value="formState.code"
            @change="onFormChange('code', $event)"
          ></text-input>
          <text class="send-code-btn" @click="sendCode" :class="{ 'disabled': countdown > 0 || sendingCode }">
            {{ countdown > 0 ? $i18n_t('bindEmailModal.resendCountdown', { countdown: countdown }) : i18nGetCodeText }}
          </text>
        </view>
        <text class="error-msg" v-if="!!errorMsg">{{ errorMsg }}</text>
        <submit-button :disabled="!formState.email || !formState.code || !codeSentSuccessfully" :submitting="verifyingCode" @click="onVerifyCode">{{ i18nNextText }}</submit-button>
      </view>

      <!-- Step 2: Reset password -->
      <view v-if="step === 2" class="form-step">
        <text class="subtitle">{{ i18nCommonResetPasswordText }}</text>
        <text-input
          :placeholder="i18nPasswordText"
          style="margin-bottom: 16px; width: 100%;"
          type="password"
          :value="formState.password"
          @change="onFormChange('password', $event)"
        ></text-input>
        <view class="password-hints">
          <text class="password-hint-item">{{ passwordMinLengthText }}</text>
          <text class="password-hint-item">{{ passwordLetterAndNumberText }}</text>
        </view>
        <text-input
          :placeholder="i18nConfirmPasswordText"
          style="margin-bottom: 16px; width: 100%;"
          type="password"
          :value="formState.confirmPassword"
          @change="onFormChange('confirmPassword', $event)"
        ></text-input>
        <text class="error-msg" v-if="!!errorMsg">{{ errorMsg }}</text>
        <submit-button :disabled="!formState.password || !formState.confirmPassword" :submitting="resettingPassword" @submit="onResetPassword">{{ i18nOkText }}</submit-button>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, reactive, ref } from "vue";
import { useSubmitRequest } from "@/hooks";
import IconFont from "@/components/IconFont/IconFont.uvue";
import TextInput from "./widgets/text-input.uvue";
import SubmitButton from "./widgets/submit-button.uvue";
import { $i18n_t } from "@/locale/index.uts";

const i18nForgotPasswordText = computed(() => $i18n_t("account.forgotPassword"));
const i18nWhatsYourEmailText = computed(() => $i18n_t("account.yourEmail"));
const i18nEmailText = computed(() => $i18n_t("common.email"));
const i18nVerityCodeText = computed(() => $i18n_t("account.verityCode"));
const i18nGetCodeText = computed(() => $i18n_t("account.getCode"));
const i18nNextText = computed(() => $i18n_t("common.next"));
const i18nCommonResetPasswordText = computed(() => $i18n_t("common.resetPassword"));
const i18nPasswordText = computed(() => $i18n_t("common.password"));
const i18nConfirmPasswordText = computed(() => $i18n_t("common.confirmPassword"));
const i18nOkText = computed(() => $i18n_t("common.confirm"));
const passwordMinLengthText = computed(() => $i18n_t("common.regexp.passwordMinLength", { length: 8 }));
const passwordLetterAndNumberText = computed(() => $i18n_t("common.regexp.passwordContainsLetterAndNumber"));

type FormState = {
  email?: string;
  code?: string;
  password?: string;
  confirmPassword?: string;
};

const step = ref(1);
const errorMsg = ref<string>("");
const formState = reactive<FormState>({});
const countdown = ref(0);
const codeSentSuccessfully = ref(false); // Track if code has been successfully sent
let timer: number | null = null;

const { submitRequest: sendCodeRequest, submitting: sendingCode } = useSubmitRequest({
  url: `auth/request-password-reset`,
  customErrorHanlder(err) {
    errorMsg.value = err.message;
  },
  onSuccess() {
    startCountdown();
    codeSentSuccessfully.value = true; // Set to true on successful code send
  },
});

const { submitRequest: verifyCodeRequest, submitting: verifyingCode } = useSubmitRequest({
  url: `auth/validate-reset-token`,
  customErrorHanlder(err) {
    errorMsg.value = err.message;
  },
  onSuccess() {
    step.value = 2;
    errorMsg.value = "";
  },
});

const { submitRequest: resetPasswordRequest, submitting: resettingPassword } = useSubmitRequest({
  url: `auth/reset-password`,
  customErrorHanlder(err) {
    errorMsg.value = err.message;
  },
  onSuccess() {
    uni.showToast({
      title: "Password reset successfully",
      icon: "success",
    });
    setTimeout(() => {
      onClose();
    }, 1500);
  },
});

const submitting = computed(() => sendingCode.value || verifyingCode.value || resettingPassword.value);

const onClose = () => {
  uni.redirectTo({
    url: "/pages/account/login",
  });
};

const onFormChange = (field: string, val: string) => {
  formState[field] = val;
  errorMsg.value = "";
};

const startCountdown = () => {
  countdown.value = 60;
  timer = setInterval(() => {
    countdown.value--;
    if (countdown.value <= 0) {
      if (timer != null) {
        clearInterval(timer);
        timer = null;
      }
    }
  }, 1000);
};

const sendCode = () => {
  if (countdown.value > 0 || !formState.email || sendingCode.value) {
    return;
  }
  // Basic email validation
  if (!/^\S+@\S+\.\S+$/.test(formState.email!)) {
    errorMsg.value = "Invalid email format";
    return;
  }
  sendCodeRequest({ email: formState.email });
};

const onVerifyCode = () => {
  if (!formState.email || !formState.code || verifyingCode.value) {
    return;
  }
  verifyCodeRequest({ email: formState.email, token: formState.code });
};

const onResetPassword = () => {
  if (!formState.password || !formState.confirmPassword || resettingPassword.value) {
    return;
  }
  if (formState.password !== formState.confirmPassword) {
    errorMsg.value = "Passwords do not match";
    return;
  }
  resetPasswordRequest({
    email: formState.email,
    token: formState.code,
    newPassword: formState.password,
  });
};

onUnload(() => {
  if (timer != null) {
    clearInterval(timer);
  }
});
</script>

<style scoped>
.container {
  flex: 1;
  background-color: #101010;
  padding: 24px;
}

.close-icon {
  position: absolute;
  top: 24px;
  left: 24px;
}

.content {
  flex: 1;
  align-items: center;
  margin-top: 80px;
}

.title {
  font-size: 17px;
  color: #fff;
  margin-bottom: 24px;
}

.progress-bar {
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 24px;
}

.progress-step {
  width: 10px;
  height: 10px;
  background-color: #444;
  border-radius: 5px;
}

.progress-step.active {
  background: linear-gradient(to bottom, #FF00D8, #FFF500);
}

.progress-divider {
  width: 68px;
  height: 1px;
  margin: 5px 16px 0 16px;
  background-color: #888; /* Gray color */
}

.form-step {
  width: 100%;
  align-items: center;
}

.subtitle {
  font-size: 22px;
  font-family: "Baloo Thambi 2-ExtraBold";
  color: #fff;
  margin-bottom: 24px;
}

.verification-code-container {
  width: 100%;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16px;
  position: relative;
}

.send-code-btn {
  position: absolute;
  right: 16px;
  top: 17px;
  font-size: 14px;
  color: #ff23b8;
}

.send-code-btn.disabled {
  color: #888; /* Grey out when disabled */
}

.error-msg {
  color: red;
  font-size: 12px;
  line-height: 18px;
  align-self: flex-start;
  margin-bottom: 8px;
}

.password-hints {
  padding: 0 24px;
  margin-top: 8px;
  width: 100%; /* Ensure it takes full width */
}

.password-hint-item {
  color: #fff;
  font-size: 12px;
  line-height: 18px;
  display: block;
}
</style>
