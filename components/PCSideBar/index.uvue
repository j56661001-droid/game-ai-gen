  cursor: pointer;
}

.feedback-button-icon {
  width: 100%;
  height: 100%;
  border: 1px solid #fb1fbb;
  border-radius: 50%;
  padding: 5px;
}

.recharge-button-icon {
  width: 100%;
  height: 100%;
}
</style>
