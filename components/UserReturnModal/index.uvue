<template>
  <view class="modal-container">
    <view class="modal-mask" @click="handleMaskClick"></view>
    <view class="modal-content">
      <!-- 绑定邮箱内容 -->
      <view class="bind-email-container">
        <view class="modal-close-button" @click="handleClose">
          <IconFont name="close" :size="12" color="#333"></IconFont>
        </view>
        <view class="welcome">
          <view class="welcome-title1">{{ $i18n_t("user_return.welcome") }}</view>
          <view class="welcome-title2">{{ $i18n_t("user_return.sub_welcome") }}</view>
          <view class="welcome-title3">
            <image class="welcome-title3-hourglass-icon" src="/static/hourglass.png" />
            {{ $i18n_t("user_return.time_left") }}
          </view>
          <view class="welcome-countdown">
            <text class="welcome-countdown-item">{{ calculateTimeRemaining(returnUserCreatedAt).days }}</text>
            {{ $i18n_t("user_return.time_left_day") }}
            <text class="welcome-countdown-item">{{ calculateTimeRemaining(returnUserCreatedAt).hours }}</text>
            {{ $i18n_t("user_return.time_left_hour") }}
            <text class="welcome-countdown-item">{{ calculateTimeRemaining(returnUserCreatedAt).minutes }}</text>
            {{ $i18n_t("user_return.time_left_minute") }}
          </view>
          <view class="welcome-title4">{{ $i18n_t("user_return.unique_reward") }}</view>
          <view class="welcome-title5">{{ $i18n_t("user_return.welcome_point") }}</view>
          <view class="welcome-points">
            <image class="welcome-points-flash-icon" src="/static/icons/flash@2x.png" />
            {{ returnUserBaseReward?.point || 0 }}
          </view>
          <view class="welcome-title6">{{ $i18n_t("user_return.welcome_point_desc") }}</view>
          <view
            :class="['welcome-btn', returnUserBaseReward?.status === 2 ? '' : 'welcome-btn-claim']"
            @click="() => returnUserBaseReward?.status === 1 && handleTaskClick(0)"
          >
            <image class="welcome-btn-gift-icon" src="/static/gift.png" />
            <text class="welcome-btn-text">{{
              returnUserBaseReward?.status === 2 ? $i18n_t("user_return.btn_claimed") : $i18n_t("user_return.btn_claim")
            }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, reactive, onMounted, onUnmounted, computed } from "vue";
import { $i18n_t } from "@/locale/index.uts";
import type { ClaimItem } from "@/types/index.uts";
import { claimRewards } from "@/api/home.uts";
import { user, creditsBalance } from "@/store/user";
import { execGTagEvent } from "@/utils/index.uts";

const props = defineProps<{
  maskClosable?: boolean;
  returnUserCreatedAt?: string;
  returnUserBaseReward?: ClaimItem;
}>();

// Emits
const emit = defineEmits<{
  (e: "close"): void;
  (e: "success"): void;
}>();

// 处理遮罩层点击
const handleMaskClick = () => {
  if (props.maskClosable) {
    emit("close");
  }
};

// 处理关闭按钮点击
const handleClose = () => {
  emit("close");
};

// 计算剩余时间
const calculateTimeRemaining = (timeString) => {
  const initialTime = new Date(timeString);
  // 计算初始时间 + 6天后的时间
  const targetTime = new Date(initialTime.getTime() + 6 * 24 * 60 * 60 * 1000);
  // 获取当前时间
  const currentTime = new Date();
  // 计算时间差（毫秒）
  const timeDiff = targetTime.getTime() - currentTime.getTime();
  // 如果目标时间已经过去，返回负数表示已过期
  if (timeDiff <= 0) {
    return {
      days: 0,
      hours: 0,
      minutes: 0,
      isExpired: true,
    };
  }
  // 计算天、小时、分钟
  const days = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
  const hours = Math.floor((timeDiff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
  const minutes = Math.floor((timeDiff % (1000 * 60 * 60)) / (1000 * 60));
  return {
    days,
    hours,
    minutes,
    isExpired: false,
  };
};

const handleTaskClick = async (rewardLevel) => {
  const res = await claimRewards(user.value.id, rewardLevel);
  if (res != null && res.success && res.data != null) {
    execGTagEvent("returning_reward", { pts: creditsBalance.value.toString(), serial: String(rewardLevel) } as AnyObject);
    //领取成功
    uni.showToast({
      title: $i18n_t("task_center.obtained_reward"),
      icon: "success",
      duration: 1000,
    });
    setTimeout(() => {
      handleClose();
      uni.navigateTo({ url: `/pages/user-return/index?userId=${user.value?.id}` });
    }, 1000);
  } else {
    console.error("Failed to load banner list:", pointsRes?.error?.message);
  }
};
</script>

