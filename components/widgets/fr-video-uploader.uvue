<template>
  <view class="fr-video-uploader">
    <view class="uploaded-video-list_container">
      <scroll-view class="uploaded-video-list" direction="horizontal">
        <template v-if="hasVideos">
          <fr-ratio-box
            v-for="(path, idx) in (videoList as string[])"
            :key="path"
            :ratio="9 / 16"
            style="position: relative"
            :class="{ 'uploaded-video-item-col-gap': idx != 0 }"
          >
            <fr-video class="uploaded-video-item" :src="perfShowVideoPath(path)" showCenterPlayBtn :controls="false" loop/>
            <view v-if="props.removable" class="uploaded-video-remove-btn" @click="onRemoveVideo(idx)">
              <icon-font name="close_filled" :size="24" color="#fff"></icon-font>
            </view>
          </fr-ratio-box>
        </template>
        <fr-ratio-box v-if="showUploadBtn" key="upload-btn" :ratio="9 / 16">
          <view class="uploader-section" @click="onVideoPicker">
            <icon-font name="video" :size="20" color="#707070" class="uploader-placeholder-icon" />
            <text class="uploader-placeholder-text">{{ uploadVideoText }}</text>
          </view>
        </fr-ratio-box>
      </scroll-view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { $i18n_t } from "@/locale/index.uts";
/**
 * TODO: 带组件功能实现，及应用
 */

// 16:9  9:16
import IconFont from "../IconFont/IconFont.uvue";
import { nativeUpload } from "@/api/request.uts";
import FrVideo from "./fr-video.uvue";
import FrRatioBox from "./fr-ratio-box.uvue";

const uploadVideoText = computed(() => $i18n_t("common.uploadVideo"));

type Props = {
  disabled?: boolean;
  value?: string[] | string;
  count?: number;
  removable?: boolean;
  customUploader?: boolean;
};

const props = withDefaults(defineProps<Props>(), { value: [], disabled: false, count: 1, removable: true, customUploader: false });
const emit = defineEmits<{
  (e: "change", info: string[] | string | null): void;
  (e: "customUploader"): void;
}>();

const uploadLock = ref<boolean>(false);
const state = reactive<{ uploading: boolean }>({ uploading: false });
const localSourceCache = reactive<UTSJSONObject>({});

const videoList = computed((): string[] => {
  if (typeof props.value == "string") {
    return [props.value];
  } else if (Array.isArray(props.value)) {
    return props.value;
  }

  return [];
});

const hasVideos = computed((): boolean => videoList.value.length >= 1);

const showUploadBtn = computed((): boolean => videoList.value.length < props.count);

const uploadVideo = async (file: any) => {
  if (uploadLock.value) {
    return;
  }

  uni.showLoading({
    title: $i18n_t("common.uploading"),
    mask: true,
  });

  try {
    let nativeFile: File;
    let localPath: string;

    // 检查是否是原生 File 对象（视频）还是临时文件路径（图片）
    if (file instanceof File) {
      // 视频文件直接是 File 对象
      nativeFile = file;
      localPath = URL.createObjectURL(file); // 创建本地预览URL
    } else {
      // 临时文件路径，需要转换
      const response = await fetch(file.path);
      const blob = await response.blob();
      nativeFile = new File([blob], file.name || 'video.mp4', { type: 'video/mp4' });
      localPath = file.path;
    }

    await nativeUpload({
      url: `files/upload`,
      file: nativeFile,
      data: {
        category: "video"
      },
    }, true)
      .then(({ data }) => {
        if (data == null) {
          return;
        }
        let fileURL: string | string[] = data.fileURL as string;
        if (props.count > 1) {
          fileURL = [...videoList.value, fileURL] as string[];
        }

        localSourceCache[data.fileURL] = localPath;

        emit("change", fileURL);
      });
  } catch (error) {
    console.error('Upload failed:', error);
    uni.showToast({
      title: $i18n_t("s_msg.uploadFailed") || "上传失败",
      icon: "none",
    });
  } finally {
    uni.hideLoading();
  }
};

const perfShowVideoPath = (path: string) => {
  return localSourceCache[path] != null ? localSourceCache[path] : path;
};

const onRemoveVideo = (idx: number) => {
  const value = videoList.value.filter((p, i) => i != idx);
  emit("change", props.count == 1 ? value[0] : value);
};

const onVideoPicker = () => {
  // 自定义方法
  if (props.customUploader) {
    emit("customUploader");
    return;
  }
  if (props.disabled) {
    return;
  }

  uni.chooseVideo({
    success(res: any) {
      const file = res.tempFile;
      if (file != null) {
        uploadVideo(file);
      }
    },
    fail(err) {
      // TODO
    },
  });
};
</script>

<style scoped>
.fr-video-uploader {
  padding: 16px;
  background-color: #1a1a1a;
}

.uploaded-video-list_container {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%;
}

.uploaded-video-list {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;

  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  border: 1px dashed #707070;
  border-radius: 4px;
  padding: 0 8px;
}

.uploaded-video-item {
  width: 100%;
  height: 100%;
  border-radius: 4px;
}

.uploaded-video-remove-btn {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 10;
}

.uploaded-video-item-col-gap {
  margin-left: 4px;
}

.uploader-section {
  height: 100%;
  width: 100%;
  border: 1px dashed #707070;
  border-radius: 4px;

  align-items: center;
  justify-content: center;
}

.uploader-placeholder-icon {
  color: #707070;
  margin-bottom: 10px;
}

.uploader-placeholder-text {
  font-size: 12px;
  font-weight: 700;
  color: #707070;
  text-align: center;
  line-height: 1.5;
}
</style>
