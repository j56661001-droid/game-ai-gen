<template>
  <scroll-view direction="horizontal" :scroll-with-animation="true" class="fr-tabs" :show-scrollbar="false" :scroll-into-view="props.activeTabKey"
  <!-- #ifdef WEB -->
  @mousedown="handleMouseDown"
  @mouseup="handleMouseUp"
  @mousemove="handleMouseMove"
  @mouseleave="handleMouseUp"
  <!-- #endif -->
  >
    <view v-for="tab in props.tabs" :id="tab.key" :key="tab.key" class="fr-tabs-item" @click="onSwitchTab(tab.key)">
      <slot name="default" :tab="tab" :selected="props.activeTabKey == tab.key">
        <slot name="label" :tab="tab" :selected="props.activeTabKey == tab.key">
          <slot name="icon" :tab="tab" :selected="props.activeTabKey == tab.key" v-if="!!tab.icon">
            <icon-font
              :name="tab.icon"
              :size="18"
              class="fr-tab-icon"
              :class="props.activeTabKey == tab.key ? 'fr-tabs-item-selected' : 'fr-tabs-item-unselected'"
            />
          </slot>
          <text class="fr-tabs-item-title" :class="props.activeTabKey == tab.key ? 'fr-tabs-item-selected' : 'fr-tabs-item-unselected'">{{ tab.title }}</text>
          <slot name="extra" :tab="tab" :selected="props.activeTabKey == tab.key"></slot>
        </slot>
        <image v-show="props.activeTabKey == tab.key" class="fr-tabs-item-active" src="/static/icons/down_arc@2x.png"></image>
      </slot>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { ref } from "vue";
import IconFont from "../IconFont/IconFont.uvue";
import { Tab } from "./type.uts";

<!-- #ifdef WEB -->
// WEB平台鼠标拖动滚动处理
const isDragging = ref<boolean>(false)
const startX = ref<number>(0)
const scrollLeft = ref<number>(0)
let scrollElement: HTMLElement | null = null

function handleMouseDown(e: MouseEvent) {
	isDragging.value = true
	startX.value = e.pageX
	scrollElement = e.currentTarget as HTMLElement
	if (scrollElement != null) {
		scrollLeft.value = scrollElement.scrollLeft
		scrollElement.style.cursor = 'grabbing'
		scrollElement.style.userSelect = 'none'
	}
}

function handleMouseUp() {
	isDragging.value = false
	if (scrollElement) {
		scrollElement.style.cursor = 'grab'
		scrollElement.style.removeProperty('user-select')
	}
}

function handleMouseMove(e: MouseEvent) {
	if (!isDragging.value) return
	e.preventDefault()
	const x = e.pageX
	const walk = (x - startX.value) * 2 // 拖动速度系数
	if (scrollElement) {
		scrollElement.scrollLeft = scrollLeft.value - walk
	}
}
<!-- #endif -->

export type Props = {
  activeTabKey: string;
  tabs: Tab[];
};

const props = defineProps<Props>();
const emit = defineEmits<{
  (e: "switch", key: string): void;
}>();

const onSwitchTab = (key: string) => {
  emit("switch", key);
};
</script>

<style scoped>
.fr-tabs {
  flex-direction: row;
  align-items: center;
  width: 100%;
  margin-bottom: 16px;
  padding: 0 4px;
}

.fr-tabs-item {
  /* flex: 1 0 auto; */
  flex-direction: row;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 0 12px;
  padding-bottom: 10px;
}

.fr-tabs-item-active {
  width: 36px;
  height: 8px;
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}

.fr-tabs-item-selected {
  color: #fff;
}

.fr-tabs-item-unselected {
  color: rgba(255, 255, 255, 0.6);
}

.fr-tab-icon {
  margin-right: 8px;
}

.fr-tabs-item-title {
  font-size: 14px;
  font-weight: bold;
}
</style>
