  width: 80px;
  height: 80px;
  margin-top: -40px;
  margin-bottom: -30px;
  margin-left: auto;
  margin-right: auto;
  display: block;
}

.title {
  font-size: 14px;
  font-weight: bold;
  margin-top: 40px;
  color: #000;
  text-align: center;
  margin-bottom: 24px;
}

.success-content {
  width: 320px;
  align-items: center;
  padding-top: 100px;

  /* flex: 1; */
}

.content-line1 {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
  line-height: 1.7;
  margin-bottom: 12px;
}

.content-line2 {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin: 8px 0;
}

.content-number {
  font-size: 48px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 8px;
}

.content-line3 {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
  line-height: 1.7;
  margin-top: 12px;
}

.button-container {
  /* flex-direction: row; */
  justify-content: space-between;
  width: 100%;
  position: absolute;
