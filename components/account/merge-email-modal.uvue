<template>
  <view class="modal-container" v-if="visible">
    <view class="modal-mask" @click="handleMaskClick"></view>
    <view class="modal-content">
      <view class="merge-email-container">
        <!-- 背景图（与 bind-email-modal 同款） -->
        <image class="background-image" src="/static/bindmail_bg.png" mode="scaleToFill"></image>

        <view class="modal-close-button" @click="handleClose">
          <IconFont name="close" :size="12" color="#333"></IconFont>
        </view>

        <!-- 顶部图标 -->
        <image class="top-logo" src="/static/icons/mergemail-logo.png" mode="aspectFit"></image>
        <!-- 主要内容区域 -->
        <view class="content-container">
          
          
          <text class="title">{{ benefitsStep3Parts.title }}</text>

          <view class="success-content">
            <text class="content-line1">{{ benefitsStep3Parts.contentLine1 }}</text>
            <view class="content-line2">
              <IconFont name="flash" :size="24"></IconFont>
              <text class="content-number">{{ awardPoints }}</text>
            </view>
            <text class="content-line3">{{ $i18n_t("bindEmailModal.benefitsSuccess") }}</text>
          </view>

          <!-- 底部按钮居中 -->
          <view class="button-container single-button">
            <view class="button confirm-button" @click="handleExplore">
              <text class="button-text">{{ $i18n_t("bindEmailModal.completeButton") }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, computed } from "vue";
import IconFont from "@/components/IconFont/IconFont.uvue";
import { getSettings } from "@/api/file.uts";
import i18n, { $i18n_t } from "@/locale/index.uts";

const props = defineProps<{
  visible: boolean;
  maskClosable?: boolean;
}>();

const emit = defineEmits<{
  (e: "close"): void;
  (e: "explore"): void;
}>();

const awardPoints = ref<number>(0);

// benefitsStep3 格式为 "标题\n副标题"，按换行拆分为 title 与 contentLine1
const benefitsStep3Parts = computed(() => {
  i18n.global.locale.value; // 依赖 locale 以在切换语言时更新
  const full = $i18n_t("bindEmailModal.benefitsStep3");
  const parts = full.split("\n");
  return {
    title: parts[0] ?? "",
    contentLine1: parts[1] ?? "",
  };
});

onMounted(async () => {
  const response = await getSettings('verification_award');
  if (response != null && response.success && response.data != null) {
    awardPoints.value = Number(response.data.value);
  }
});

function handleMaskClick() {
  if (props.maskClosable !== false) {
    emit("close");
  }
}

function handleClose() {
  emit("close");
}

function handleExplore() {
  emit("explore");
}
</script>

