  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  margin-top: 24px;
  padding: 0 20px;
  box-sizing: border-box;
}

.divider-line-item {
  flex: 1;
  height: 1px;
  background-color: rgba(255, 255, 255, 0.3);
}

.divider-line-text {
  padding: 0 16px;
  font-size: 14px;
  color: #fff;
  white-space: nowrap;
}

.third-party-login-buttons {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  width: 100%;
  margin-top: 24px;
  padding: 0 20px;
  box-sizing: border-box;
}

.third-party-login-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12px;
  border-radius: 8px;
  background-color: rgba(255, 255, 255, 0.1);
  border: none;
}

.third-party-login-button-icon {
  width: 24px;
  height: 24px;
  margin-bottom: 4px;
}

.third-party-login-button-icon-badge {
  width: 16px;
  height: 16px;
  position: absolute;
  top: 0;
  right: 0;
}
.third-party-login-button-text {
  font-size: 12px;
  color: #fff;
  text-align: center;
}
</style>
