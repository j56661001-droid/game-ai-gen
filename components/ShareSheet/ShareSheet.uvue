	}

	.action-icon {
		align-items: center;
		background-color: rgba(255, 255, 255, 0.05);
		border-radius: 24px;
		display: flex;
		height: 48px;
		justify-content: center;
		width: 48px;
	}

	.action-icon {
		margin-bottom: 5px; /* Add some space between icon and label */
	}

	.action-icon.delete-icon {
		background-color: rgba(255, 0, 0, 0.1); /* Red background for delete icon */
	}

	.action-label {
