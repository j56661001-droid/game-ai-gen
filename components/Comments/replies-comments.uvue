  margin-top: 15px;
  padding-left: 0px;
  /* Indent replies */
  /* border-left: 2px solid #333; */
}

.reply-item {
  margin-bottom: 15px;
  padding-right: 0;
}

.comment-item {
  display: flex;
  flex-direction: row;
  margin-bottom: 20px;
}

.avatar {
  width: 30px;
  height: 30px;
  border-radius: 15px;
  margin-right: 10px;
}

.comment-content {
  flex: 1;
}

.comment-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-direction: row;
}

.comment-info {
  display: flex;
  align-items: center;
  flex-direction: row;
}

.time {
  color: #888;
  font-size: 13px;
  margin-right: 15px;
}

.reply-button {
  color: #aaa;
  font-size: 13px;
}

.like-button {
  font-size: 18px;
}

.view-replies {
  margin-top: 8px;
}

.view-replies-text {
  color: #66b3ff;
  font-size: 13px;
}

.username {
  color: #707070;
  font-size: 12px;
  font-weight: bold;
  margin-bottom: 5px;
}

.text {
  color: #fff;
  font-size: 14px;
  line-height: 20px;
  margin-bottom: 5px;
}

.reply-input {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  background-color: #fff;
  height: 50px;
}
</style>
