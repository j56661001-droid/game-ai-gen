  width: 20px;
  height: 20px;
  display: flex;
  background-color: #404040;
  border-radius: 10px;
  justify-content: center;
  align-items: center;
  position: absolute;
  right: 12px; /* Align to the right */
  top: 12px; /* Center vertically */
}

.comments-list {
  flex: 1;
  padding: 8px 4px 8px 24px;
}

.comment-item {
  display: flex;
  flex-direction: row;
  padding-right: 20px;
  margin-bottom: 20px;
}

.avatar {
  width: 48px;
  height: 48px;
  border-radius: 20px;
  margin-right: 10px;
}

.comment-content {
  flex: 1;
}

.username {
  color: #707070;
  font-size: 12px;
  line-height: 17px;
  font-weight: bold;
  margin-bottom: 8px;
}

.text {
  color: #fff;
  font-size: 14px;
  line-height: 20px;
  margin-bottom: 5px;
}

.comment-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-direction: row;
}

.comment-info {
  display: flex;
  align-items: center;
  flex-direction: row;
}

.time {
  color: #888;
  font-size: 12px;
  margin-right: 15px;
}

.reply-button {
  color: #aaa;
  font-size: 12px;
}

.like-button {
  font-size: 18px;
}

.font_family {
  font-family: "font_family" !important;
}

.liked-color {
  color: $uni-text-color-light;
}

.default-color {
  color: #ffffff;
}

.view-replies {
  margin-top: 8px;
}

.view-replies-text {
  color: #66b3ff;
  font-size: 13px;
}

// .replies-list {
//   margin-top: 15px;
//   padding-left: 0px;
//   /* Indent replies */
//   /* border-left: 2px solid #333; */
// }

// .reply-item {
//   margin-bottom: 15px;
//   padding-right: 0;
// }

.comment-input-area {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 15px;
  background-color: #333;
  border-radius: 20px;
}

.comment-input {
  flex: 1;
  height: 36px;
  padding: 10px 15px;
  color: #fff;
  font-size: 15px;
  margin-right: 10px;
}

.emoji-button {
  font-size: 22px;
}
</style>
