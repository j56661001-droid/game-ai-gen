  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #1c1c1c;
  border-top-left-radius: 20px;
  border-top-right-radius: 20px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.comments-header {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 8px 16px;
  position: relative;
}

.drag-handle {
  width: 46px;
  height: 4px;
  background-color: #888;
  border-radius: 2px;
  margin-bottom: 16px;
}

.comments-count {
  color: #fff;
  font-size: 14px;
}

