import BpMediaDisplay from "@/components/panels/bp-media-display.uvue";
import FrMoreStatus from "@/components/widgets/fr-more-status.uvue";
import FrBackTop from "@/components/widgets/fr-back-top.uvue";
import { isMobileBrowser, isCapacitor, getDomainFromUrl, isDevelopmentEnv, isTelegramMiniApp } from "@/utils/platform.uts";
import { execGTagEvent } from "@/utils/index.uts";
import { getAbsoluteMediaUrl, config } from "@/api/request.uts";
import { openExternalTopupPage } from "@/utils/navigator.uts";
import { guestAutoAuth, GuestAuthResponse } from "@/api/fingerprint.uts";
import { generateDeviceFingerprint } from "@/utils/fingerprint.uts";
import { getAffiliateLink, AffiliateLinkResponse } from "@/api/affiliate.uts";
import { getAigfUrl, loginAigf, logoutAigf } from "@/api/index.uts";
import { executeRedirect, type RedirectConfig } from "@/utils/thirdAuth.uts";
import FrActivityEntrance from "@/components/widgets/fr-activity-entrance.uvue";
import {
  isReturnUser as isReturnUserStore,
  returnUserCreatedAt as returnUserCreatedAtStore,
  showLotteryEntrance as showLotteryEntranceStore,
} from "@/store/menu.uts";

const isWideScreen = ref(false);

const handleResize = () => {
  isWideScreen.value = window.innerWidth > 899.98;
};

const aigfAuthUrl = ref<string>("");
const isNavigatingToAigf = ref(false);
const isReturnUser = ref<boolean>(false);
const returnUserCreatedAt = ref<string>();
const returnUserBaseReward = ref();
const showUserReturnModal = ref<boolean>(false);

// Computed property for the base domain
const baseDomain = computed(() => getDomainFromUrl(config.baseUrl));

// Computed property for the current frontend base URL (protocol + host)
const currentFrontendBaseUrl = computed(() => {
  if (typeof window !== "undefined" && window.location.protocol && window.location.host) {
    return `${window.location.protocol}//${window.location.host}`;
  }
  // Fallback for environments where window.location might not be fully available or meaningful
  // In a web/Capacitor context, window.location should generally be available.
  return "";
});

// Helper function to check if a URL is an internal link for direct uni navigation
function isInternalLink(fullUrl: string): string | null {
  if (!fullUrl || typeof fullUrl !== "string") {
    return null;
  }

  // Handle root-relative paths that are known to be internal
  if (fullUrl.startsWith("/pages/") || fullUrl.startsWith("/static/")) {
    return fullUrl;
  }

  const baseUrl = currentFrontendBaseUrl.value;
  if (!baseUrl) {
    return null;
  }

  try {
    const url = new URL(fullUrl);
    // Ensure the domain matches the current frontend base URL
    if (url.origin === baseUrl) {
      const path = url.pathname;
      const search = url.search;
      // Check if the path starts with /pages/ or /static/
      if (path.startsWith("/pages/") || path.startsWith("/static/")) {
        return path + search;
      }
    }
  } catch (error) {
    // URL parsing failed for what we assume is an absolute or invalid URL.
    // This is expected for relative paths not caught above, so we can just let it be.
    // console.error("Error parsing URL in isInternalLink:", fullUrl, error);
  }
  return null;
}

// Reactive wrapper for fmtBackendLang
function reactiveFmtBackendLang(info: string | UTSJSONObject | null | undefined): ComputedRef<string> {
  return computed(() => {
    // Depend on i18n.global.locale.value to re-calculate when locale changes
    const currentLocale = i18n.global.locale.value;
    return fmtBackendLang(info);
  });
}

const zonesTitleText = computed(() => $i18n_t("home.zonesTitle"));
const viewMoreText = computed(() => $i18n_t("common.viewMore"));
const aiToolsTitleText = computed(() => $i18n_t("home.aiToolsTitle"));
const videosTitleText = computed(() => $i18n_t("home.videosTitle"));
const topicsTitleText = computed(() => $i18n_t("home.topicsTitle"));
const starsTitleText = computed(() => $i18n_t("home.starsTitle"));
const forYouText = computed(() => $i18n_t("home.forYou"));
const loadingText = computed(() => $i18n_t("common.loading_"));
const noMoreText = computed(() => $i18n_t("common.noMore"));

const warnVersion = ref("");

const showAigfEntrance = ref(true);
const showLotteryEntrance = ref(true);

// --- State ---
const isMobile = ref(!isTelegramMiniApp());
const showBanner = ref(true); // 控制下载banner的显示
const allWaterfallItems = ref<PostItem[]>([]); // All items for waterfall

const interspersedList = computed(() => {
  // 仅在宽屏且aigf入口显示时插入广告
  if (isWideScreen.value && showAigfEntrance.value) {
    const result: (PostItem | { type: string; id: string })[] = [];
    const items = allWaterfallItems.value;
    for (let i = 0; i < items.length; i++) {
      result.push(items[i]);
      // 每30个项目后插入一个广告
      if (i % 30 === 0) {
        result.push({ type: "ad", id: `ad-${i}` });
      }
    }
    return result;
  }

  // 在其他情况下，直接返回原始瀑布流项目数组以提高性能
  return allWaterfallItems.value;
});

const actualScrollTop = ref(0); // Tracks the actual scroll position
const currentScrollPosition = ref(0); // Used to programmatically set scroll position

const languages = ref<Language[]>(availableLanguages);

// 获取当前语言的索引
function getLanguageIndex(): number {
  const currentLocale = getLocale();
  const index = languages.value.findIndex((lang) => lang.code === currentLocale);
  return index >= 0 ? index : 0; // 如果找不到匹配的语言，默认返回0
}

const languageIndex = ref(getLanguageIndex());
const showLanguagePicker = ref(false);
// const showWarnModal = ref(false);
const NEW_PLAYER_MODAL_LAST_SHOWN_DATE_KEY = "newPlayerModalLastShownDate";

const showNewPlayerModal = ref(false); // New reactive variable to control new player modal visibility
const newPlayerUsername = ref<string>("");
const newPlayerDeviceFingerprint = ref<string | null>(null);
const newPlayerOfficialWebsites = ref<string[]>([]);
const warnModalTitle = ref("");
const warnModalContent = ref("");
const showBindEmailModal = ref(false);
const showMergeEmailModal = ref(false);
const mergeEmailRedirectConfig = ref<{ from?: string; to?: string; action?: string; toAction?: string; fromAction?: string } | null>(null);
const newPlayerModalLastShownDate = ref<string | null>(null);

// picker-view 样式配置
const indicatorStyle = ref("height: 40px; line-height: 40px;");

// 轮播图数据
const bannerList = ref<BannerItem[]>([]);
const floatingButtonData = ref<Link | null>(null); // New reactive variable for floating button

// 独立数据定义
const zoneData = ref<CategoryItem[]>([]);
const aiToolsData = ref<CategoryListWithChildren[]>([]);
const shortVideosData = ref<PostItem[]>([]);
const topicsData = ref<CategoryItem[]>([]);
const starsData = ref<CategoryListWithChildren[]>([]);

const currentSwiperIndex = ref(0);

let autoplayTimer: number | null = null;
//切换轮播图
const advanceSwiper = () => {
  if (bannerList.value.length > 0) {
    currentSwiperIndex.value = (currentSwiperIndex.value + 1) % bannerList.value.length;
  }
};

const handleVideoEnd = () => {
  advanceSwiper();
};

const stopAutoplay = () => {
  if (autoplayTimer != null) {
    clearTimeout(autoplayTimer);
    autoplayTimer = null;
  }
};

const startAutoplay = () => {
  stopAutoplay();
  if (bannerList.value.length == 0) return;

  const currentItem = bannerList.value[currentSwiperIndex.value];
  if (currentItem != null && currentItem.mimeType !== "video") {
    // It's an image, switch after 3 seconds
    autoplayTimer = setTimeout(() => {
      advanceSwiper();
    }, 5000);
  }
  // For videos, the @ended event will trigger the switch
};

const onSwiperChange = (e: UniSwiperChangeEvent) => {
  const prevIndex = currentSwiperIndex.value;
  currentSwiperIndex.value = e.detail.current;

  // 暂停上一个视频
  const prevVideoItem = bannerList.value[prevIndex];
  if (prevVideoItem != null && prevVideoItem.mimeType == "video") {
    const prevVideoContext = uni.createVideoContext(`bannerVideo-${prevIndex}`);
    if (prevVideoContext != null) prevVideoContext.pause();
  }

  // 播放当前视频
  const currentVideoItem = bannerList.value[currentSwiperIndex.value];
  if (currentVideoItem != null && currentVideoItem.mimeType == "video") {
    const currentVideoContext = uni.createVideoContext(`bannerVideo-${currentSwiperIndex.value}`);
    if (currentVideoContext != null) {
      // #ifdef APP
      // 在App端，seek(0)可以确保视频从头播放
      currentVideoContext.seek(0);
      // #endif
      currentVideoContext.play();
    }
  }
  startAutoplay();
};

const onDotClick = (index: number) => {
  currentSwiperIndex.value = index;
};

// #ifdef WEB
let isMouseDown = false;
let startX = 0;
let endX = 0;

const handleMouseDown = (e: MouseEvent) => {
  isMouseDown = true;
  startX = e.clientX;
};

const handleMouseMove = (e: MouseEvent) => {
  if (!isMouseDown) return;
  endX = e.clientX;
};

const handleMouseUp = () => {
  if (!isMouseDown) return;
  isMouseDown = false;

  const threshold = 50; // 拖动阈值
  const deltaX = endX - startX;

  if (deltaX > threshold) {
    // 向右滑动，切换到上一张
    currentSwiperIndex.value = (currentSwiperIndex.value - 1 + bannerList.value.length) % bannerList.value.length;
  } else if (deltaX < -threshold) {
    // 向左滑动，切换到下一张
    currentSwiperIndex.value = (currentSwiperIndex.value + 1) % bannerList.value.length;
  }
};
// #endif

const onScroll = (e: UniScrollEvent) => {
  actualScrollTop.value = e.detail.scrollTop;
};

const headerBgStyle = computed(() => {
  const opacity = Math.min(actualScrollTop.value / 1000, 1);
  return {
    // background: `linear-gradient(to bottom, rgba(18, 18, 18, ${opacity}), rgba(18, 18, 18, 0))`,
    "background-color": `rgba(18, 18, 18, ${opacity})`,
  };
});

const loading = ref(false);
const noMore = ref(false);
let page = 1;
const pageSize = 10;

async function loadMoreData() {
  if (loading.value || noMore.value) {
    return;
  }
  loading.value = true;
  try {
    let res;
    if(user.value){
      res = await getForyou(page, pageSize);
    }else{
      res = await getForyouOld(page, pageSize);
    }
    
    if (res != null && res.success && res.data != null) {
      allWaterfallItems.value = [...allWaterfallItems.value, ...res.data];
      if (res.meta == null || !res.meta.pagination.has_next) {
        noMore.value = true;
      } else {        
        page++;
      }
    } else {
      noMore.value = true;
    }
  } catch (err) {
    noMore.value = true;
  } finally {
    loading.value = false;
  }
}

