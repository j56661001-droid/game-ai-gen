    <!-- Floating Button -->
    <!-- <view v-if="floatingButtonData != null" class="floating-button-wrapper" @click="handleBannerLinkClick(floatingButtonData)">
      <image :src="getAbsoluteMediaUrl(floatingButtonData.icon)" class="floating-button-icon"></image>
