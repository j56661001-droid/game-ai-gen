const loadHomeSections = async () => {
  const promises = [loadBannerList(), loadTrendingZone(), loadPopularTopics(), loadStars(), loadEffects(), loadShortVideos(), loadFloatingButton()];

  // Use Promise.allSettled to ensure all promises complete, regardless of individual success or failure.
  const results = await Promise.allSettled(promises);

  // Optional: Log any rejected promises for debugging.
  results.forEach((result, index) => {
    if (result.status === "rejected") {
      // You can create a mapping from index to promise name for clearer logs.
      console.error(`A promise in loadHomeSections failed (index ${index}):`, result.reason);
    }
  });
};

// Helper to extract subdomain
const getSubdomain = (host: string): string | null => {
  const parts = host.split(".");
  if (parts.length > 2) {
    // Assuming format like subdomain.domain.tld
    return parts[0];
  }
  return null;
};

// 根据设备指纹创建临时账号 (调用API)
const initGuestAutoAuth = async () => {
  if (isTelegramMiniApp()) {
    return;
  }
  let currentDeviceFingerprint: string | null = null;
  let currentOfficialWebsites: string[] = [];
  let currentUsername: string = "";

  try {
    // 1. 获取设备指纹
    if (fingerprintFromUrl.value != null) {
      currentDeviceFingerprint = fingerprintFromUrl.value;
    } else {
      currentDeviceFingerprint = await generateDeviceFingerprint();
    }

    if (currentDeviceFingerprint == null) {
      console.error("Failed to get device fingerprint.");
      return; // Do not show modal if fingerprint is not available
    }

    // Check if user.value already exists
    if (user.value != null) {
      currentUsername = user.value.username;
    } else {
      // 2. 根据设备指纹创建临时账号
      let click_id = tokenStorage.get<string>("click_id") || null;
      console.log("guestAutoAuth")
      const result = await guestAutoAuth({
        deviceFingerprint: currentDeviceFingerprint,
        source: import.meta.env.VITE_APP_SOURCE,
        click_id: click_id,
      });
      if (result != null && result.success && result.data != null) {
        if (result.data.user) {
          tokenStorage.set<string>("token", result.data.accessToken);
          user.value = result.data.user;
          currentUsername = user.value?.username;
        } else {
          showNewPlayerModal.value = false;
          return;
        }
      } else {
        return; // Do not show modal if guest auto-auth fails
      }
    }

    // 3. 获取当前域名信息并处理二级域名逻辑
    let currentHost: string | null = null;
    if (isCapacitor()) {
      // Capacitor environment: keep original logic
      currentHost = baseDomain.value;
      currentOfficialWebsites = [currentHost];
    } else {
      // Non-Capacitor environment: apply subdomain logic
      if (typeof window !== "undefined" && window.location.hostname != null) {
        if (isDevelopmentEnv()) {
          currentHost = baseDomain.value;
        } else {
          currentHost = `https://${window.location.hostname}`;
        }
      } else {
        currentHost = baseDomain.value;
      }

      let subdomain: string | null = null;
      if (currentHost != null) {
        const url = new URL(currentHost);
        subdomain = getSubdomain(url.hostname);
      }

      if (subdomain != null) {
        // If subdomain exists, fetch affiliate links
        const affiliateResult = await getAffiliateLink(subdomain);
        if (affiliateResult != null && affiliateResult.success && affiliateResult.data != null) {
          const domains = affiliateResult.data.distributorDomain.split(",").map((d) => d.trim());
          currentOfficialWebsites = ["https://seseai.com"]; //domains;
        } else {
          currentOfficialWebsites = [currentHost != null ? currentHost : baseDomain.value];
        }
      } else {
        // No subdomain, use the current host as the official website
        currentOfficialWebsites = [currentHost != null ? currentHost : baseDomain.value];
      }
    }

    // If all steps are successful, set the state to show the modal
    newPlayerUsername.value = currentUsername;
    newPlayerDeviceFingerprint.value = currentDeviceFingerprint;
    newPlayerOfficialWebsites.value = currentOfficialWebsites;

    // Check if the modal was shown today
    newPlayerModalLastShownDate.value = storage.get<string>(NEW_PLAYER_MODAL_LAST_SHOWN_DATE_KEY);
    const today = getTodayDateString();

    if (newPlayerModalLastShownDate.value != today) {
      showNewPlayerModal.value = true;
      storage.set(NEW_PLAYER_MODAL_LAST_SHOWN_DATE_KEY, today);
    } else {
      showNewPlayerModal.value = false;
    }
  } catch (e: any) {
    // If any error occurs, ensure the modal is not shown
    showNewPlayerModal.value = false;
  }
};

const initializeHomeData = async () => {
  // 首先等待 initGuestAutoAuth 完成，无论成功与否
  try {
    await initGuestAutoAuth();
  } catch (e) {
    console.error("initGuestAutoAuth failed:", e);
  }
  
  // --- Fire-and-forget tasks (run in background) ---
  loadHomeSections(); // Now internally resilient thanks to Promise.allSettled
  loadIntroSettings().catch((e) => console.error("loadIntroSettings failed:", e));
  getUserReturnData().catch((e) => console.error("getUserReturnData failed:", e));
  

  loadMoreData().catch((e) => console.error("loadMoreData failed:", e));

  // --- Synchronous tasks ---
  checkAigfTopupRedirect();

  // --- Await critical settings needed for UI ---
  const [aigfSetting, lotterySetting, verificationAward] = await Promise.all([
    getSettings("enable.aigf").catch((e) => {
      console.error("getSettings(enable.aigf) failed:", e);
      return null;
    }),
    getSettings("enable.lottery").catch((e) => {
      console.error("getSettings(enable.lottery) failed:", e);
      return null;
    }),
    getSettings("verification_award").catch((e) => {
      console.error("getSettings(verification_award) failed:", e);
      return null;
    }),
  ]);

  // --- Process results of awaited promises ---
  if (aigfSetting?.success && aigfSetting.data != null) {
    showAigfEntrance.value = String(aigfSetting.data.value).toLowerCase() === "true";
  }

  if (lotterySetting?.success && lotterySetting.data != null) {
    showLotteryEntrance.value = String(lotterySetting.data.value).toLowerCase() === "true";
    showLotteryEntranceStore.value = String(lotterySetting.data.value).toLowerCase() === "true";
  }

  if (verificationAward?.success && verificationAward.data != null) {
    awardPoints.value = Number(verificationAward.data.value);
  }

  // This depends on the result of verificationAward promise
  checkBindEmailModal();
};

const loadAigfUrl = async () => {
  const res = await getAigfUrl();
  if (res.success && res.data != null) {
    aigfAuthUrl.value = res.data.authUrl;
  }
};

onMounted(() => {
  handleResize(); // Initial check
  window.addEventListener("resize", handleResize);

  // 先注册事件监听器，确保能接收到后续发送的事件
  uni.$on("onFollowStatusChange", (data: { userId: string; isFollowing: boolean }) => {
    const { userId, isFollowing } = data;
    starsData.value.forEach((categoryItem) => {
      const userIndex = categoryItem.users.findIndex((user) => user.id == userId);
      if (userIndex != -1) {
        if (isFollowing) {
          categoryItem.users[userIndex].followersCount += 1;
        } else {
          categoryItem.users[userIndex].followersCount -= 1;
        }
        categoryItem.users[userIndex].isFollowing = isFollowing;
      }
    });
  });

  // 监听合并邮箱弹窗显示事件
  uni.$on("merge-email:show", handleMergeEmailShow);

  // 检查是否需要弹出合并邮箱弹窗
  const mailemail = tokenStorage.get<string>("mailemail");
  if (mailemail === "true") {
    // 弹出merge-email-modal.uvue，传递空的重定向配置
    uni.$emit("merge-email:show", {});
    console.log("弹出merge-email-modal.uvue");
  }

  // 监听 userInited 变量，确保在用户信息初始化完成后再加载首页数据
  watch(
    userInited,
    async (newValue) => {
      if(!newValue)return;
      try {
        console.log("watch userInited: ", newValue)
        await initializeHomeData();
      } catch (e) {
        console.error("initializeHomeData failed", e);
      }
      if (shouldGoToAigf.value && showAigfEntrance.value) {
        goToAigf();
      } else if (shouldGoToAigf.value && !showAigfEntrance.value) {
        console.warn("Attempted to navigate to AIGF, but entrance is disabled by settings.");
      }
    },
    { immediate: true },
  ); // immediate: true 确保在组件挂载时立即执行一次，如果 userInited 已经为 true

  // 新增：监听 user 对象的变化，并在用户数据更新后重新检查绑定邮箱弹窗
  watch(user, (newValue, oldValue) => {
    if (newValue != null && newValue.accountType !== "guest") {
      checkBindEmailModal();
    }
  });
});

onUnmounted(() => {
  window.removeEventListener("resize", handleResize);
  uni.$off("onFollowStatusChange");
  uni.$off("merge-email:show", handleMergeEmailShow);
});

