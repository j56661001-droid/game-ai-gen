import AdaptiveWebWaterfallN from "@/components/WebWaterfall/AdaptiveWebWaterfallN.uvue";
import BpNewplayer from "@/components/panels/bp-newplayer.uvue";
import BindEmailModal from "@/components/account/bind-email-modal.uvue";
import MergeEmailModal from "@/components/account/merge-email-modal.uvue";
import UserReturnModal from "@/components/UserReturnModal/index.uvue";
import { ref, watch, nextTick, computed, onMounted, onUnmounted } from "vue";
import { setVideoResourceList, setVideoInitialIndex, storage, setWebviewConfig } from "../../store/index.uts";
import { user, userInited, bindEmailModalClosedManually, fingerprintFromUrl, tokenStorage, isAigfLogoutLocked } from "../../store/user.uts";
import { getTodayDateString } from "@/utils/date.uts";
import { getPopularTopics, getTrendingZone, getStars, getEffets, getForyou, getForyouOld, getShortVideos, getBannerList, getReturnUserRewards } from "../../api/home.uts";
import { getSettings } from "../../api/file.uts";
import { BpNotificationIcon } from "@/components/panels";
import { $i18n_t, fmtBackendLang, setLocale, getLocale, Language, availableLanguages } from "@/locale/index.uts";
