const handleBannerLinkClick = (link: Link) => {
  if (link.isPost) {
    uni.redirectTo({ url: `/pages/index/index?tabbar=video&id=${link.postID}` });
  } else {
    const relativePath = isInternalLink(link.url);
    if (relativePath !== null) {
      // If it's an internal link and we got a relative path, navigate directly
      uni.navigateTo({ url: relativePath });
    } else if (link.isOpenNewTab) {
      // If not internal and is set to open in a new tab, use window.open
      window.open(link.url, "_blank");
    } else {
      // Otherwise, open in webview
      setWebviewConfig({ url: link.url, isAigf: false, title: reactiveFmtBackendLang(link.title).value });
      uni.navigateTo({ url: `/pages/webview/webview` });
    }
  }
};

