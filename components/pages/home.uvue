const goToLuckyWheel = () => {
  if (isCapacitor()) {
    const token = tokenStorage.get<string>("token");
    if (user.value == null || !token) { //|| user.value.accountType === "guest"
      uni.showModal({
        title: $i18n_t("home.aigfLoginRequiredTitle"),
        content: $i18n_t("home.aigfLoginRequiredContent"),
        confirmText: $i18n_t("common.login"),
        cancelText: $i18n_t("common.cancel"),
        success: (res) => {
          if (res.confirm) {
            uni.$emit("login:show");
          }
        },
      });
      return;
    }
    const url = `https://${baseDomain.value}/lottery/?token=${token}`;
    setWebviewConfig({ url: url, isAigf: false, title: $i18n_t("home.activityEntrance.luckyWheel") });
    uni.navigateTo({ url: "/pages/webview/webview" });
  } else {
    // Original behavior for web
    if (user.value == null ) { //|| user.value.accountType == "guest"
      uni.$emit("login:show", { page: "register", to: "/lottery/", action: "href", successRedirectOnly: true });
      return;
    }
    window.location.href = "/lottery/";
  }
};

const goToAffiliate = () => {
  if (user.value == null || user.value.accountType == "guest") {
    uni.$emit("login:show", { page: "register", to: "/pages/affiliate/index?from=home&tabbar=home", successRedirectOnly: true });
  } else {
    uni.navigateTo({ url: "/pages/affiliate/index?tabbar=home" });
  }
};

const goToAigf = async () => {
  if (user.value == null || user.value?.accountType === "guest") {
    uni.showModal({
      title: $i18n_t("home.aigfLoginRequiredTitle"),
      content: $i18n_t("home.aigfLoginRequiredContent"),
      confirmText: $i18n_t("common.login"),
      cancelText: $i18n_t("common.cancel"),
      success: (res) => {
        if (res.confirm) {
          uni.$emit("login:show");
        }
      },
    });
    return;
  }

  if (isAigfLogoutLocked.value) {
    uni.showToast({
      title: $i18n_t("home.aigfLogoutInProgress"), // 需要在 locale 中添加这个 key
      icon: "none",
    });
    return;
  }

  if (isNavigatingToAigf.value) {
    return;
  }

  isNavigatingToAigf.value = true;
  try {
    if (!userInited.value) {
      uni.showToast({
        title: $i18n_t("home.gettingUserInfo"),
        icon: "none",
      });
      return;
    }
    uni.showToast({
      title: $i18n_t("home.gettingAigfUrl"),
      icon: "none",
    });
    await loadAigfUrl();
    if (!aigfAuthUrl.value) {
      uni.showToast({
        title: $i18n_t("home.getAigfUrlFailed"),
        icon: "none",
      });
      return;
    }
    setWebviewConfig({ url: aigfAuthUrl.value, isAigf: true, title: $i18n_t("home.aigfBannerTitle") });
    uni.redirectTo({
      url: `/pages/webview/webview`,
    });
  } finally {
    isNavigatingToAigf.value = false;
  }
};

const checkAigfTopupRedirect = () => {
  const topupInfoJSON = uni.getStorageSync("aigf_topup_redirect");
  if (topupInfoJSON != null && topupInfoJSON != "") {
    try {
      const topupInfo = JSON.parse(topupInfoJSON as string) as UTSJSONObject;
      const timestamp = topupInfo["timestamp"] as number;
      const type = topupInfo["type"] as string;

      // Check if it's an AIGF top-up and within the 20-minute window
      if (type === "aigf_topup" && Date.now() - timestamp < 20 * 60 * 1000) {
        uni.showModal({
          title: $i18n_t("aigf.return_prompt.title"),
          content: $i18n_t("aigf.return_prompt.content"),
          cancelText: $i18n_t("aigf.return_prompt.cancel"),
          confirmText: $i18n_t("aigf.return_prompt.confirm"),
          success: (res) => {
            if (res.confirm) {
              goToAigf();
            }
          },
          complete: () => {
            uni.removeStorageSync("aigf_topup_redirect");
            uni.removeStorageSync("aigf_last_webview_url");
          },
        });
      } else {
        // If expired or not an AIGF top-up, just clear the storage
        uni.removeStorageSync("aigf_topup_redirect");
        uni.removeStorageSync("aigf_last_webview_url");
      }
    } catch (e) {
      console.error("Failed to parse aigf_topup_redirect from localStorage", e);
      uni.removeStorageSync("aigf_topup_redirect");
      uni.removeStorageSync("aigf_last_webview_url");
    }
  }
};

const getUserReturnData = async () => {
  if (user.value == null || user.value.accountType === "guest") return;
  try {
    const res = await getReturnUserRewards(user.value?.id);
    if (res != null && res.success && res.data != null) {
      const base = (res.data?.claimRecords || []).filter((item) => item.rewardLevel === 0)[0];
      isReturnUser.value = res.data?.is_return || false;
      isReturnUserStore.value = res.data?.is_return || false;
      returnUserCreatedAt.value = res.data?.createdAt;
      returnUserCreatedAtStore.value = res.data?.createdAt;
      returnUserBaseReward.value = base;
      // 弹窗显示控制
      if (res.data?.is_return) {
        showUserReturnModal.value = base.status === 1;
      } else {
        showUserReturnModal.value = false;
      }
    } else {
      console.error("Failed to load banner list:", pointsRes?.error?.message);
    }
  } catch (error) {
    console.error("Failed to fetch affiliate data:", error);
  }
};

// 计算回归用户活动剩余时间
const calculateTimeRemaining = (timeString) => {
  const formatTime = (date) => {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, "0");
    const day = String(date.getDate()).padStart(2, "0");
    const hours = String(date.getHours()).padStart(2, "0");
    const minutes = String(date.getMinutes()).padStart(2, "0");
    const seconds = String(date.getSeconds()).padStart(2, "0");
    return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
  };
  const initialTime = new Date(timeString);
  // 计算初始时间 + 6天后的时间
  const targetTime = new Date(initialTime.getTime() + 6 * 24 * 60 * 60 * 1000);
  // 获取当前时间
  const currentTime = new Date();
  // 计算时间差（毫秒）
  const timeDiff = targetTime.getTime() - currentTime.getTime();
  // 如果目标时间已经过去，返回负数表示已过期
  if (timeDiff <= 0) {
    return {
      value: formatTime(currentTime),
      isExpired: true,
    };
  }
  return {
    value: formatTime(targetTime),
    isExpired: false,
  };
};

// 处理回归用户奖励弹窗
const handleUserReturnModalClose = () => {
  showUserReturnModal.value = false;
};
</script>

