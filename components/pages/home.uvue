      if (res.success) {
        execGTagEvent("aigf_leave", { pts: res.data ? res.data.balance.toString() : "0", type: "login" } as AnyObject);
      }
    };
    executeRedirect(mergeEmailRedirectConfig.value, $logoutAigf);
    mergeEmailRedirectConfig.value = null;
  }
};

