<template>
  <fr-adaptive-list
    refresher-enabled
    :min-column="2"
    :min-width="230"
    :loading="loading"
    :data-source="result.records"
    :pagination="result.pagination"
    :empty-text="emptyText"
    @refresh="onRefresh"
    @loadmore="onLoadMore"
  >
    <template #record="{ record }:UTSJSONObject">
      <view class="list-card">
        <view class="list-card-body">
          <bp-media-display
            :type="record.coverMimeType == 'video' ? 'video' : 'image'"
            class="card-img"
            :src="getAbsoluteMediaUrl(record.cover)"
            :autoplay="true"
            :show-center-play-btn="false"
            :object-fit="'cover'"
            v-if="record.coverMimeType == 'video' || record.coverMimeType == 'image'"
          ></bp-media-display>
          <image src="/static/new.png" class="new-icon" v-if="record.isNew"></image>
          <view class="card-footer">
            <text class="card-title">{{ fmtBackendLang(record.displayName) }}</text>
            <!-- <text class="card-text">{{ fmtBackendLang(record.description) }}</text> -->
            <button class="card-btn" @click="onGoToGenerator(record.id)">
              {{ $i18n_t("publish.tryItNow") }}
            </button>
          </view>
        </view>
      </view>
    </template>
  </fr-adaptive-list>
</template>

<script setup lang="uts">
import { $i18n_t, fmtBackendLang } from "@/locale/index.uts";
import IconFont from "@/components/IconFont/IconFont.uvue";
import { useLoadListRequest, LoadListRequestOptions } from "@/hooks";
import { FrAdaptiveList } from "@/components/widgets";
import { execGTagEvent } from "@/utils/ga.uts";
import { getAbsoluteMediaUrl } from "@/api/request.uts";
import BpMediaDisplay from "@/components/panels/bp-media-display.uvue";

const props = defineProps<{
  categoryId: string;
}>();

const { loadListRequest, loading, result } = useLoadListRequest({
  url: `ai-tools`,
} as LoadListRequestOptions);

watch(
  () => props.categoryId,
  (id) => {
    if (id != null) {
      loadListRequest({ categoryID: id, page: 1 });
    }
  },
  {
    immediate: true,
  },
);

const emptyText = $i18n_t("publish.noAITool");

const onRefresh = () => {
  loadListRequest({ page: 1, categoryID: props.categoryId });
};

const onLoadMore = ({ page }) => {
  loadListRequest({ page, categoryID: props.categoryId });
};

const onGoToGenerator = (id: string) => {
  execGTagEvent("tools", { toolID: id, category: props.categoryId } as AnyObject);

  uni.navigateTo({ url: `/pages/publish/ai-generator?id=${id}` });
};
</script>

