  flex: 1;
  flex-wrap: wrap;
  padding-bottom: 103px;
}

.list-item {
  margin-bottom: 24px;
}

.list-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.list-card {
  flex: 1;
}

.new-icon {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 39px;
  height: 23px;
  z-index: 5;
}

.list-card-body {
  width: 100%;
  position: relative;
  padding-top: 150%;
}

:deep(.uni-list-view-container) {
  padding: 0 16px;
  box-sizing: border-box;
}

.card-img {
  position: absolute;
  top: 0;
  height: 100%;
  width: 100%;
  border-radius: 4px;
}

.card-title {
  font-size: 14px;
  font-weight: bold;
  color: #fff;

  margin-bottom: 6px;
}

.card-text {
  font-size: 12px;
  color: #fff;
  margin-bottom: 12px;
}

.card-footer {
  position: absolute;
  padding: 10px;
  top: 0;
  bottom: 0;
  width: 100%;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0), rgb(0, 0, 0));

  align-items: center;
  justify-content: flex-end;
  z-index: 1;
}

.card-btn {
  border-radius: 30px;
  font-size: 14px;
  padding-left: 24px;
  padding-right: 24px;
  color: #fff;
  font-family: "Baloo Thambi 2-ExtraBold";
  background: linear-gradient(to bottom right, #ff00d8, #fff500);
}
</style>
