<template>
  <view class="splash-container">
    <image class="splash-background" src="/static/splash.png" mode="cover"></image>
    <view class="main-content-wrapper">
      <image class="webname-image" src="/static/icons/welcome_logo@2x.png"></image>
      <view class="promo-banner">
        <!-- 背景：包含闪电和 HOT SALE -->
        <image class="promo-banner-bg" src="/static/splash_header@2x.png" mode="widthFix"></image>
        <!-- 文本：UP TO 50% OFF -->
        <text class="promo-banner-text">{{ fmtBackendLang(welcomeData?.title) }}</text>
      </view>

      <!-- 标题 -->
      <text class="create-ai-title">{{ fmtBackendLang(welcomeData?.subtitle) }}</text>

      <!-- 视频区域 -->
      <view class="video-container">
        <view class="video-wrapper">
          <bp-media-display
            style="width:100%"
            mediaClassName="video-player"
            :type="getFileTypeBySuffix(welcomeData?.renderings?.source?.fileURL)"
            :src="welcomeData?.renderings?.source?.fileURL"
            :autoplay="true"
            :loop="true"
            :muted="true"
            :autoresize="true"
            :controls="false"
            object-fit="cover"
          ></bp-media-display>
          <text class="video-desc">{{ fmtBackendLang(welcomeData?.renderings?.source?.displayName) }}</text>
        </view>
        <view class="video-wrapper">
          <bp-media-display
            style="width:100%"
            mediaClassName="video-player"
            :type="getFileTypeBySuffix(welcomeData?.renderings?.target?.fileURL)"
            :src="welcomeData?.renderings?.target?.fileURL"
            :autoplay="true"
            :loop="true"
            :autoresize="true"
            :muted="true"
            :controls="false"
            object-fit="cover"
          ></bp-media-display>
          <text class="video-desc">{{ fmtBackendLang(welcomeData?.renderings?.target?.displayName) }}</text>
        </view>
      </view>

      <!-- Next 按钮 -->
      <button class="action-button gradient-next-button" @click="handleSplashClick">{{ $i18n_t("welcome.next_button") }}</button>
    </view>
  </view>
</template>

<script setup lang="uts">
import { $i18n_t, fmtBackendLang } from "@/locale/index.uts";
import BpMediaDisplay from "@/components/panels/bp-media-display.uvue";
import { getFileTypeBySuffix } from "@/utils/format.uts";
import type { WelcomeSettings } from '@/types/index.uts'

defineProps<{
  welcomeData: WelcomeSettings | null;
}>();

const handleSplashClick = async () => {
  try {
    console.log("handleSplashClick")
    await uni.redirectTo({ url: "/pages/index/index" });
  } catch (err: any) {
    if (err != null) {
      console.error("navigateTo failed", err);
    } else {
      console.error("navigateTo failed: unknown error");
    }
  }
};

</script>

