<template>
  <view class="new-content-container">
    <image class="webname-image" src="/static/icons/welcome_logo@2x.png"></image>
    <!-- <text class="title">{{ $i18n_t('welcome.new_content.title') }}</text> -->
    <image src="/static/new.png" class="new-icon"></image>
    
    <view class="toolname-container">
      <view class="toolnameblur"></view>
      <text class="toolname">{{ currentToolName }}</text>
    </view>

    <view class="banner-container">
      <image :src="currentToolInfo.image" class="banner-image" mode="aspectFit"></image>
      <button class="create-button" @click="handleNext">{{ $i18n_t('welcome.new_content.create_button') }}</button>
    </view>

    <view class="footer-link" @click="goToHome">
      <text class="footer-text">{{ $i18n_t('welcome.new_content.go_home') }}</text>
      <IconFont name="arrowright" :size="8" color="#ffffff"></IconFont>
    </view>
  </view>
</template>

<script setup lang="uts">
import IconFont from "@/components/IconFont/IconFont.uvue";
import { $i18n_t } from "@/locale/index.uts";
import { computed, onMounted, ref } from 'vue';

type ToolInfo = {
  key: string;
  image: string;
};

const toolInfos: ToolInfo[] = [
  { key: 'disney_cowgirl', image: '/static/new-tools/3d_disney_cowgirl.png' },
  { key: 'eva_rei_real', image: '/static/new-tools/eva_rei_real.png' },
  { key: 'm_binding_disney', image: '/static/new-tools/m_binding_disney.png' },
  { key: 'm_binding_chinese_3d', image: '/static/new-tools/m_binding_chinese_3d.png' },
  { key: 'robin_chinese_3d', image: '/static/new-tools/robin_chinese_3d.png' },
  { key: 'onepiece_nami_real', image: '/static/new-tools/onepiece_nami_real.png' }
];

const currentToolInfo = ref<ToolInfo>({
  key: '',
  image: ''
});

const currentToolName = computed((): string => {
	if (!currentToolInfo.value.key) {
		return ''
	}
	return $i18n_t(`welcome.new_content.tools.${currentToolInfo.value.key}`)
})

onMounted(() => {
  const randomIndex = Math.floor(Math.random() * toolInfos.length);
  currentToolInfo.value = toolInfos[randomIndex];
});

const handleNext = async () => {
  try {
    await uni.redirectTo({ url: "/pages/index/index?tabbar=publish&catecategory=image_to_anime" });
  } catch (err: any) {
    if (err != null) {
      console.error("navigateTo failed", err);
    } else {
      console.error("navigateTo failed: unknown error");
    }
  }
};

const goToHome = async () => {
  try {
    await uni.redirectTo({ url: "/pages/index/index?tabbar=home" });
  } catch (err: any) {
    if (err != null) {
      console.error("navigateTo failed", err);
    } else {
      console.error("navigateTo failed: unknown error");
    }
  }
};
</script>

