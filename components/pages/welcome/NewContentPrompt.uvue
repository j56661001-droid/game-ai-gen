  position: absolute;
  background: #ff23b8;
  width: 180px;
  height: 24px;
  border-radius: 24px;
  top: 12px;
  filter: blur(19px);
  opacity: 0.8;
}

.toolname {
  color: #ffffff;
  font-size: 16px;
  font-weight: bold;
  text-shadow: 0px 5px 8px rgba(255, 0, 255, 0.75);
  z-index: 1;
}

.banner-container {
  position: relative;
  width: 100%;
  margin-top: -15px;
  display: flex;
  justify-content: center;
  overflow: visible;
  flex: 1;
  min-height: 0;
  align-items: center;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 12px;
}

.create-button {
  position: absolute;
  bottom: -18px;
  left: 50%;
