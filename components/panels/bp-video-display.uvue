<template>
  <view :id="containerId" class="video-creation-container" :style="videoStyle" @click="onClick">
    <!-- 背景视频：当 背景 参数非 null 时显示，毛玻璃效果 -->
    <video
      v-if="props.background != null"
      ref="bgVideoRef"
      class="bg-video"
      :class="{ 'bg-video--static': props.background === 'static', 'bg-video--dynamic': props.background === 'dynamic' }"
      :src="videoUrl"
      :poster="props.background === 'static' && props.cover ? getAbsoluteMediaUrl(props.cover) : undefined"
      :autoplay="props.background === 'dynamic' && props.autoplay"
      :muted="true"
      :loop="props.background === 'dynamic'"
      :show-center-play-btn="false"
      :controls="false"
      :show-progress="false"
      object-fit="cover"
    />
    <image 
      v-if="props.cover != null" 
      class="video-creation-cover-img" 
      :mode="props.imageMode" 
      :src="getAbsoluteMediaUrl(props.cover)" 
      @load="onLoadImage" @error="onImageError" 
      style="position: absolute;"
    />
    <video
      v-else
      ref="videoPlayer"
      class="video-creation-body"
      show-loading
      :object-fit="props.objectFit"
      :id="props.id"
      :show-center-play-btn="false"
      :controls="props.controls"
      :show-progress="props.showProgress"
      :autoplay="props.autoplay"
      :enable-progress-gesture="props.enableProgressGesture"
      :loop="props.loop"
      :muted="props.muted"
      :src="videoUrl"
      :crossOrigin="props.crossOrigin"
      @timeupdate="onTimeupdate"
      @ended="onEnded"
      @loadedmetadata="onLoadedMetaData"
      @error="onVideoError"
      @waiting="onWaiting"
      @progress="onProgress"
      @play="onPlay"
      @pause="onPause"
      <!-- #ifdef WEB -->
      :style="props.background && videoWidth && videoHeight ? { '--video-width': videoWidth + 'px', '--video-height': videoHeight + 'px' } : {}"
      <!-- #endif -->
    />
    <view v-if="isLoading" class="video-play-loading-bg"></view>
    <view v-if="isLoading || isWaiting" class="video-play-loading">
      <fr-spin />
    </view>
    <view v-else v-show="showPlayBtn" class="video-play-btn" @click="onPlayClick">
      <icon-font name="play" :size="18" />
    </view>
  </view>
</template>

<script setup lang="uts">
import IconFont from "../IconFont/IconFont.uvue";
import { FrSpin } from "../widgets";
import { getAbsoluteMediaUrl } from "@/api/request.uts";
import Hls from "hls.js";
import { onUnmounted, onMounted, nextTick, getCurrentInstance } from "vue";
type Video = any;

/** 背景模式：静态=只显示封面不播放，动态=同步播放，null/不传=不启用毛玻璃 */
type BackgroundMode = "static" | "dynamic" | null;

type Props = {
  src: string;
  cover?: string;
  encryptionKey?: string;
  controls?: boolean;
  showProgress?: boolean;
  showCenterPlayBtn?: boolean;
  autoplay?: boolean;
  enableProgressGesture?: boolean;
  loop?: boolean;
  muted?: boolean;
  id?: string;
  autoresize?: boolean;
  crossOrigin?: string;
  imageMode?: string;
  objectFit?: string;
  listPlay?: boolean;
  /** 背景：静态=毛玻璃+封面，动态=毛玻璃+同步播放，null/不传=不启用 */
  background?: BackgroundMode;
};

const props = withDefaults(defineProps<Props>(), { 
  controls: false, 
  showCenterPlayBtn: true, 
  autoresize: true, 
  imageMode: "aspectFill", 
  objectFit: "contain", 
  listPlay: false,
  background: null,
});

const emit = defineEmits<{
  (e: "load", v: Uni.UniVideoLoadedMetadataEvent | Uni.UniImageLoadEvent): void;
  (e: "ended", v: UniEvent): void;
  (e: "timeupdate", v: UniVideoTimeUpdateEvent): void;
  (e: "click", v: UniPointerEvent): void;
  (e: "progress", v: UniVideoProgressEvent): void;
  (e: "waiting", v: UniEvent): void;
  (e: "play", v: UniEvent): void;
  (e: "pause", v: UniEvent): void;
  (e: "error", v: UniVideoErrorEvent | UniImageErrorEvent): void;
  (e: "click:play", v: UniPointerEvent): void;
}>();

const videoStyle = ref<string>(`padding-bottom: 100%`);
const isLoading = ref<boolean>(false);
const isWaiting = ref<boolean>(false);
const isPlaying = ref<boolean>(false);
const isBuffered = ref<boolean>(false);

const showPlayBtn = computed((): boolean => props.showCenterPlayBtn && !isPlaying.value);

const videoPlayer = ref<Video | null>(null);
const videoUrl = ref<string>("");
const bgVideoRef = ref<Video | null>(null);
const bgVideoUrl = ref<string>("");
const containerId = ref<string>("bp-video-container-" + Math.random().toString(36).slice(2));
let hls: Hls | null = null;

/** 从主视频或背景视频元数据得到的尺寸，用于 getVideoRatio */
const videoMetaWidth = ref<number>(0);
const videoMetaHeight = ref<number>(0);
const containerWidth = ref<number>(0);
const containerHeight = ref<number>(0);
const videoWidth = ref<number>(0);
const videoHeight = ref<number>(0);
/** 容器尺寸加载状态，用于避免首次获取失败 */
const containerSizeLoading = ref<boolean>(true);
/** 弹窗关闭/隐藏时设为 true，并清除定时器，不再重试 getContainerSize */
let isUnmounted = false;
let containerSizeDelayTimer: number | null = null;
let containerSizeRetryTimer: number | null = null;

const instance = getCurrentInstance();

const destroyHls = () => {
  if (hls) {
    hls.destroy();
    hls = null;
  }
};

// 监听video播放状态
// watch(isPlaying, (newVal) => {
//   if (props.background !== 'dynamic') return;
//   if (newVal) {
//     bgVideoRef.value?.play();
//   } else {
//     bgVideoRef.value?.pause();
//   }
// });


watch(
  () => ({
    videoSrc: props.src,
    imageSrc: props.cover,
  }),
  (media) => {
    destroyHls();

    if ((!media.imageSrc || media.imageSrc == "") && (!media.videoSrc || media.videoSrc == "")) {
      return;
    }

    isLoading.value = true;
    isBuffered.value = false;
    if (!props.autoresize) {
      videoStyle.value = `height: 100%`;
    }

    if (media.imageSrc) {
      // Cover is present, do nothing with video
      return;
    }

    if (media.videoSrc) {
      const absoluteSrc = getAbsoluteMediaUrl(media.videoSrc);
      if (media.videoSrc.endsWith(".m3u8")) {
        nextTick(() => {
          // The '$el' is necessary to get the underlying HTMLVideoElement
          const uniVideoElement = videoPlayer.value as HTMLElement;
          if (!uniVideoElement) {
            console.error("uni-video element not found");
            return;
          }
          const videoElement = uniVideoElement.querySelector(".uni-video-video") as HTMLVideoElement;
          if (!videoElement) {
            console.error("Video element not found");
            return;
          }

          if (Hls.isSupported()) {
            console.log("HLS.js is supported, using it to play video.");
            videoUrl.value = ""; // Let HLS.js manage the src
            hls = new Hls();
            hls.loadSource(absoluteSrc);
            hls.attachMedia(videoElement);
            hls.on(Hls.Events.ERROR, (event, data) => {
              console.error("HLS error:", data);
              onVideoError({
                type: "error",
                timeStamp: Date.now(),
                detail: { errMsg: `HLS error: ${data.details}` },
              } as UniVideoErrorEvent);
            });
          } else if (videoElement.canPlayType("application/vnd.apple.mpegurl")) {
            console.log("Native HLS is supported.");
            videoUrl.value = absoluteSrc;
          } else {
            console.error("HLS is not supported on this browser.");
            videoUrl.value = absoluteSrc; // Fallback to let browser try
          }
        });
      } else {
        videoUrl.value = absoluteSrc;
      }
    }
  },
  { immediate: true, deep: true },
);

/**
 * 获取容器宽高。弹窗关闭/隐藏时 onUnmounted 会清定时器并设 isUnmounted，不再重试。
 */
const getContainerSize = () => {
  if (isUnmounted) return;
  nextTick(() => {
    if (isUnmounted) return;
    try {
      containerSizeDelayTimer = setTimeout(() => {
        containerSizeDelayTimer = null;
        if (isUnmounted) return;
        const query = uni.createSelectorQuery().in(instance);
        query.select("#" + containerId.value).boundingClientRect((rect: any) => {
          if (isUnmounted) return;
          if (rect != null && rect.width != null && rect.width > 0 && rect.height != null && rect.height > 0) {
            containerWidth.value = rect.width;
            containerHeight.value = rect.height;
            containerSizeLoading.value = false;
            if (videoMetaWidth.value > 0 && videoMetaHeight.value > 0) {
              setVideoSize();
            }
          } else {
            if (isUnmounted) return;
            containerSizeRetryTimer = setTimeout(() => {
              containerSizeRetryTimer = null;
              getContainerSize();
            }, 100);
          }
        }).exec();
      }, 50);
    } catch (e) {
      console.error("bp-video-display: Failed to get container size:", e);
      containerSizeLoading.value = false;
    }
  });
};

/**
 * 获得缩放后视频尺寸
 */
function setVideoSize() {
  // 如果容器尺寸或视频元数据未准备好，不进行计算
  if (containerSizeLoading.value || containerWidth.value <= 0 || containerHeight.value <= 0 || videoMetaWidth.value <= 0 || videoMetaHeight.value <= 0) {
    return;
  }

  let newWidth, newHeight;

  // 比较视频与容器的宽高比（使用乘法避免浮点数精度问题）
  if (videoMetaWidth.value * containerHeight.value >= containerWidth.value * videoMetaHeight.value) {
      // 视频较宽，以容器宽度为基准进行缩放
      newWidth = containerWidth.value;
      newHeight = (containerWidth.value * videoMetaHeight.value) / videoMetaWidth.value;
  } else {
      // 视频较高，以容器高度为基准进行缩放
      newWidth = (containerHeight.value * videoMetaWidth.value) / videoMetaHeight.value;
      newHeight = containerHeight.value;
  }
  videoWidth.value = Math.round(newWidth);
  videoHeight.value = Math.round(newHeight);
}

// Web 端：使用 ResizeObserver 监听容器大小变化
let resizeObserver: ResizeObserver | null = null;
let windowResizeHandler: (() => void) | null = null;
onMounted(() => {
  if (!props.background) return;

  // 使用 nextTick 确保 DOM 已渲染后再查询
  nextTick(() => {
    getContainerSize();
  });
  
  // #ifdef WEB
  nextTick(() => {
    try {
      if (typeof ResizeObserver !== "undefined" && ResizeObserver != null) {
        // 延迟一下确保 DOM 完全渲染
        setTimeout(() => {
          // 查找实际的 DOM 元素
          const containerElement = document.getElementById(containerId.value);
          if (containerElement != null) {
            // 创建 ResizeObserver 监听容器大小变化
            resizeObserver = new ResizeObserver((entries: ResizeObserverEntry[]) => {
              for (const entry of entries) {
                const { width, height } = entry.contentRect;
                if (width > 0 && height > 0) {
                  containerWidth.value = width;
                  containerHeight.value = height;
                  containerSizeLoading.value = false;
                  setVideoSize();
                }
              }
            });
            
            // 开始观察容器元素
            resizeObserver.observe(containerElement);
          } else {
            // 如果获取失败，延迟重试
            setTimeout(() => {
              const retryElement = document.getElementById(containerId.value);
              if (retryElement != null) {
                resizeObserver = new ResizeObserver((entries: ResizeObserverEntry[]) => {
                  for (const entry of entries) {
                    const { width, height } = entry.contentRect;
                    if (width > 0 && height > 0) {
                      containerWidth.value = width;
                      containerHeight.value = height;
                      containerSizeLoading.value = false;
                      setVideoSize();
                    }
                  }
                });
                resizeObserver.observe(retryElement);
              }
            }, 100);
          }
        }, 50);
      } else {
        // 降级方案：如果 ResizeObserver 不支持，使用窗口 resize
        windowResizeHandler = () => {
          getContainerSize();
          setVideoSize();
        };
        if (typeof window !== "undefined" && window != null && window.addEventListener != null) {
          window.addEventListener("resize", windowResizeHandler);
        }
      }
    } catch (e) {
      console.error("bp-video-display: Failed to setup resize observer:", e);
      // 降级到窗口 resize
      windowResizeHandler = () => {
        getContainerSize();
        setVideoSize();
      };
      if (typeof window !== "undefined" && window != null && window.addEventListener != null) {
        window.addEventListener("resize", windowResizeHandler);
      }
    }
  });
  // #endif
});

onUnmounted(() => {
  isUnmounted = true;
  if (containerSizeDelayTimer != null) {
    clearTimeout(containerSizeDelayTimer);
    containerSizeDelayTimer = null;
  }
  if (containerSizeRetryTimer != null) {
    clearTimeout(containerSizeRetryTimer);
    containerSizeRetryTimer = null;
  }
  destroyHls();
  // #ifdef WEB
  try {
    // 清理 ResizeObserver
    if (resizeObserver != null) {
      resizeObserver.disconnect();
      resizeObserver = null;
    }
    // 清理窗口 resize 监听器（降级方案）
    if (windowResizeHandler != null && typeof window !== "undefined" && window != null && window.removeEventListener != null) {
      window.removeEventListener("resize", windowResizeHandler);
      windowResizeHandler = null;
    }
  } catch (e) {
    console.error("bp-video-display: Failed to cleanup resize observer:", e);
  }
  // #endif
});

const onLoadImage = (e: UniImageLoadEvent) => {
  if (props.autoresize) {
    const rate = (e.detail.height / e.detail.width) * 100;
    videoStyle.value = `padding-bottom: ${rate}%`;
  } else {
    videoStyle.value = `height: 100%`;
  }

  isLoading.value = false;

  emit("load", e);
};

const onImageError = (e: UniImageErrorEvent) => {
  isLoading.value = false;

  emit("error", e);
};

const onLoadedMetaData = (e: Uni.UniVideoLoadedMetadataEvent) => {
  
  if (props.background) {
    videoMetaWidth.value = e.detail.width ?? 0;
    videoMetaHeight.value = e.detail.height ?? 0;
  }
  if (props.autoresize) {
    const rate = (e.detail.height / e.detail.width) * 100;
    videoStyle.value = `padding-bottom: ${rate}%`;
  } else {
    videoStyle.value = `height: 100%`;
  }

  isLoading.value = false;

  // 视频元数据加载后，如果容器尺寸已准备好，立即计算视频尺寸
  // 如果容器尺寸还未准备好，等待容器尺寸加载完成后再计算
  if (!containerSizeLoading.value && containerWidth.value > 0 && containerHeight.value > 0) {
    setVideoSize();
  } else {
    // 如果容器尺寸还在加载中，确保在容器尺寸加载完成后会调用 setVideoSize
    // getContainerSize 函数中已经处理了这种情况
  }

  emit("load", e);
};

const onPlay = (e: UniEvent) => {
  isPlaying.value = true;
  isWaiting.value = false;
  if (props.background === 'dynamic') {
    // 同步进度
    bgVideoRef.value?.play();
  }

  emit("play", e);
};

const onPause = (e: UniEvent) => {
  isPlaying.value = false;
  if (props.background === 'dynamic') {
    bgVideoRef.value?.pause();
  }
  emit("pause", e);
};

const onTimeupdate = (e: UniVideoTimeUpdateEvent) => {
  isWaiting.value = false;
  isPlaying.value = true;

  emit("timeupdate", e);
};

const onWaiting = (e: UniEvent) => {
  if (isBuffered.value) {
    return;
  }

  isWaiting.value = true;

  emit("waiting", e);
};

const onProgress = (e: UniVideoProgressEvent) => {
  if (e.detail?.buffered == 100) {
    isBuffered.value = true;
  }

  emit("progress", e);
};

const onEnded = (e: UniEvent) => {
  if (!props.autoplay) {
    isPlaying.value = false;
  }

  emit("ended", e);
};

const onVideoError = (e: UniVideoErrorEvent) => {
  isLoading.value = false;

  emit("error", e);
};

const onClick = (e: UniPointerEvent) => {
  emit("click", e);
};

const onPlayClick = (e: UniPointerEvent) => {
  emit("click:play", e);
  if (!props.listPlay) return;
  e.stopPropagation();
  videoPlayer.value?.play();
};
</script>

<style scoped>
.video-creation-container {
  position: relative;
  width: 100%;
  background-color:rgb(26, 26, 26);
}

/* 背景视频：毛玻璃效果，仅在 背景 参数非 null 时显示，置于最底层 */
.bg-video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  pointer-events: none;
  filter: blur(50px);
  transform: scale(1.1);
  /* z-index: 0; */
}
.bg-video--static {
  /* 静态：不自动播放，仅显示封面 */
}
.bg-video--dynamic {
  /* 动态：同步播放 */
}

/* 主内容（视频/封面）在背景之上 */

.video-creation-body {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: var(--video-width, 100%);
  height: var(--video-height, 100%);
  pointer-events: none;
  /* z-index: 1; */
}

.video-creation-cover-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  /* z-index: 1; */
}

.video-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 40px;
  height: 40px;
  border-radius: 20px;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  /* z-index: 3; */
}

.video-play-loading-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  background-color: #1a1a1a;
  /* z-index: 2; */
}

.video-play-loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.5);
  width: 40px;
  height: 40px;
  border-radius: 20px;
  display: flex;
  justify-content: center;
  align-items: center;
  /* z-index: 3; */
}
</style>

