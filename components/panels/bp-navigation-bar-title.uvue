<template>
  <view style="flex: 1">
    <slot></slot>
  </view>
</template>

<script setup lang="uts">
import { $i18n_t } from "@/locale/index.uts";

const props = defineProps<{ title?: string }>();

onPageShow(() => {
  if (props.title != null) {
    uni.setNavigationBarTitle({
      title: props.title,
    });
    return;
  }

  const pages = getCurrentPages();
  const pageSize = pages.length;
  if (pageSize > 0) {
    const currentPage = pages[pageSize - 1];

    let titleRoute = currentPage.route.replace(/\//g, "&");
    if (titleRoute != null) {
      titleRoute = titleRoute.replace(/\&/, ".");
    }

    if (currentPage.route == "pages/index/index" && currentPage.options?.tabbar != null) {
      titleRoute += `&${currentPage.options.tabbar}`;
    }

    uni.setNavigationBarTitle({
      title: "SESE AI | " + $i18n_t(titleRoute),
    });
  }
});
</script>

<style scoped></style>
